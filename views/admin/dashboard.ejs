<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NCLMN2BEVN"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-NCLMN2BEVN');
  </script>
  <meta charset="utf-8">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>لوحة التحكم — <%= t.seo_site_name %></title>
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/pages/admin.css">
</head>
<body>
<div class="admin-shell">

  <%- include('./_sidebar', { currentPage: 'dashboard' }) %>

  <div class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-topbar-title">لوحة التحكم</h1>
      <span class="admin-topbar-user">
        <i class="fas fa-user-shield"></i>
        <%= adminUser.firstName %> <%= adminUser.lastName %>
      </span>
    </div>

    <div class="admin-content">

      <% if (successMessage) { %>
        <div class="admin-alert admin-alert-success"><i class="fas fa-check-circle"></i> <%= successMessage %></div>
      <% } %>
      <% if (errorMessage) { %>
        <div class="admin-alert admin-alert-error"><i class="fas fa-exclamation-circle"></i> <%= errorMessage %></div>
      <% } %>

      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-users"></i></div>
          <div class="stat-info">
            <div class="stat-label">المستخدمون</div>
            <div class="stat-value"><%= userCount %></div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-box-open"></i></div>
          <div class="stat-info">
            <div class="stat-label">المنتجات</div>
            <div class="stat-value"><%= productCount %></div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-magic"></i></div>
          <div class="stat-info">
            <div class="stat-label">باترنات محفوظة</div>
            <div class="stat-value"><%= savedPatternCount %></div>
          </div>
        </div>
      </div>

      <section class="admin-dashboard-section">
        <div class="admin-dashboard-section-head">
          <div>
            <p class="admin-eyebrow">آخر الإضافات</p>
            <h2>أحدث المنتجات</h2>
          </div>
          <a href="/ezshm_crochem/products">إدارة كل المنتجات <i class="fas fa-arrow-left"></i></a>
        </div>
        <% if (!latestProducts.length) { %>
          <div class="admin-empty"><i class="fas fa-box-open"></i>لا توجد منتجات بعد.</div>
        <% } else { %>
          <div class="admin-dashboard-products">
            <% latestProducts.forEach(function (product) { %>
              <a class="admin-dashboard-product" href="/ezshm_crochem/products">
                <span class="admin-dashboard-product-icon"><i class="fas fa-box-open"></i></span>
                <span class="admin-dashboard-product-info"><strong><%= product.product_name || 'منتج بلا اسم' %></strong><small><%= product.user ? `${product.user.firstName || ''} ${product.user.lastName || ''}`.trim() : `مستخدم #${product.user_id}` %></small></span>
                <span class="status-pill <%= product.is_published ? 'status-live' : 'status-hidden' %>"><%= product.is_published ? 'منشور' : 'مخفي' %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>

    </div>
  </div>

</div>
</body>
</html>

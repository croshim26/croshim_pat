<button class="admin-menu-toggle" type="button" aria-label="فتح قائمة الإدارة" aria-controls="adminSidebar" aria-expanded="false">
  <i class="fas fa-bars"></i>
</button>
<div class="admin-sidebar-backdrop" aria-hidden="true"></div>
<aside class="admin-sidebar" id="adminSidebar">
  <a class="admin-brand" href="/ezshm_crochem">
    <div class="admin-brand-badge">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
        <path d="M10 2 L10 13 C10 16.5 7 17.5 5.2 16 C3.5 14.5 4 12.5 6.2 12.2"
          stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="10" cy="2" r="1.4" fill="white"/>
      </svg>
    </div>
    <div>
      <div class="admin-brand-name"><%= t.seo_site_name %></div>
      <div class="admin-brand-sub">لوحة الإدارة</div>
    </div>
  </a>

  <ul class="admin-nav">
    <li>
      <a href="/ezshm_crochem" class="<%= currentPage === 'dashboard' ? 'active' : '' %>">
        <i class="fas fa-th-large"></i>
        لوحة التحكم
      </a>
    </li>
    <li>
      <a href="/ezshm_crochem/users" class="<%= currentPage === 'users' ? 'active' : '' %>">
        <i class="fas fa-users"></i>
        المستخدمون
      </a>
    </li>
    <li>
      <a href="/ezshm_crochem/products" class="<%= currentPage === 'products' ? 'active' : '' %>">
        <i class="fas fa-box-open"></i>
        المنتجات
      </a>
    </li>
    <li>
      <a href="/ezshm_crochem/saved-patterns" class="<%= currentPage === 'saved-patterns' ? 'active' : '' %>">
        <i class="fas fa-magic"></i>
        الباترنات المحفوظة
      </a>
    </li>
    <li>
      <a href="/ezshm_crochem/user-activity" class="<%= currentPage === 'user-activity' ? 'active' : '' %>">
        <i class="fas fa-chart-line"></i>
        نشاط المستخدمين
      </a>
    </li>
    <li>
      <a href="/ezshm_crochem/feedback" class="<%= currentPage === 'feedback' ? 'active' : '' %>">
        <i class="fas fa-comment-dots"></i>
        الاقتراحات والشكاوى
      </a>
    </li>
    <li style="margin-top:10px;padding:0 10px;">
      <div style="border-top:1px solid rgba(255,255,255,.12);margin-bottom:10px;"></div>
    </li>
  </ul>

  <div class="admin-sidebar-footer">
    <a href="/">
      <i class="fas fa-external-link-alt"></i>
      العودة للموقع
    </a>
  </div>
</aside>

<script>
  (function () {
    const button = document.querySelector('.admin-menu-toggle');
    const sidebar = document.getElementById('adminSidebar');
    const backdrop = document.querySelector('.admin-sidebar-backdrop');
    if (!button || !sidebar || !backdrop) return;
    const close = () => { document.body.classList.remove('admin-menu-open'); button.setAttribute('aria-expanded', 'false'); };
    button.addEventListener('click', () => {
      const open = document.body.classList.toggle('admin-menu-open');
      button.setAttribute('aria-expanded', String(open));
    });
    backdrop.addEventListener('click', close);
    sidebar.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
  })();
</script>

<%- include('../partials/activity_tracker') %>

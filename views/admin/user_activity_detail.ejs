<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>سجل النشاط — <%= t.seo_site_name %></title><link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css"><link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/pages/admin.css"></head>
<body><div class="admin-shell"><%- include('./_sidebar', { currentPage: 'user-activity' }) %><div class="admin-main"><div class="admin-topbar"><h1 class="admin-topbar-title">سجل نشاط المستخدم</h1><span class="admin-topbar-user"><i class="fas fa-user-shield"></i><%= adminUser.firstName %> <%= adminUser.lastName %></span></div><main class="admin-content">
  <a class="activity-back-link" href="/ezshm_crochem/user-activity"><i class="fas fa-arrow-right"></i> العودة إلى نشاط المستخدمين</a>
  <% const activity = user.activity || {}; %>
  <section class="user-detail-hero"><div class="user-avatar user-avatar-large"><i class="fas fa-user"></i></div><div><h2><%= user.firstName %> <%= user.lastName %></h2><p><%= user.email %></p><p class="user-acquisition-line"><i class="fas fa-bullseye"></i> مصدر الاكتساب: <strong><%= activity.acquisition ? `${activity.acquisition.first_source} / ${activity.acquisition.first_medium}` : 'غير متاح' %></strong><% if (activity.acquisition?.first_campaign) { %> · <%= activity.acquisition.first_campaign %><% } %></p></div><div class="user-detail-summary"><span><strong><%= Number(activity.visitCount || 0) %></strong> زيارة</span><span><strong><%= Math.floor(Number(activity.timeSeconds || 0) / 60) %></strong> دقيقة مسجلة</span></div></section>
  <section class="admin-products-panel"><div class="admin-dashboard-section-head"><div><p class="admin-eyebrow">التسلسل الزمني</p><h2>آخر 100 تفاعل</h2></div></div>
  <% if (!events.length) { %><div class="admin-empty"><i class="fas fa-history"></i>لا يوجد نشاط مسجل لهذا المستخدم بعد.</div><% } else { %><div class="activity-timeline"><% events.forEach(function(event){ %><div class="activity-event"><span class="activity-event-icon"><i class="fas <%= event.event_name === 'page_view' ? 'fa-eye' : event.event_name === 'page_time' ? 'fa-clock' : 'fa-mouse-pointer' %>"></i></span><div><strong><%= eventLabels[event.event_name] || event.event_name %></strong><p><%= event.page_path || 'تفاعل داخل المنصة' %><% if (event.duration_seconds) { %> · <%= event.duration_seconds %> ثانية<% } %></p></div><time><%= new Date(event.createdAt).toLocaleString('ar-SA') %></time></div><% }) %></div><% } %>
  </section></main></div></div></body></html>

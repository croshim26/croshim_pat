<style>
  .hero-nav .dropdown-menu {
    background: rgba(78, 35, 52, 0.98);
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 14px;
    backdrop-filter: blur(12px);
    padding: .5rem;
    min-width: 210px;
    margin-top: .4rem;
  }
  .hero-nav .dropdown-item {
    color: rgba(255,255,255,.88);
    font-family: 'Cairo', sans-serif;
    font-weight: 700;
    font-size: .9rem;
    border-radius: 10px;
    padding: .5rem .85rem;
    display: flex;
    align-items: center;
    gap: .5rem;
    transition: background .15s;
  }
  .hero-nav .dropdown-item:hover,
  .hero-nav .dropdown-item:focus {
    background: rgba(255,255,255,.13);
    color: #fff;
  }
  .hero-nav .dropdown-item.active-item {
    background: rgba(255,255,255,.18);
    color: #fff;
  }
  .hero-nav .dropdown-divider {
    border-color: rgba(255,255,255,.12);
    margin: .35rem .5rem;
  }
  .hero-nav .dropdown-toggle::after {
    margin-right: .35rem;
    margin-left: 0;
    vertical-align: .18em;
  }
  .nav-add-btn {
    background: rgba(255,255,255,.13);
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 14px;
    color: rgba(255,255,255,.92) !important;
    font-family: 'Cairo', sans-serif;
    font-weight: 800;
    padding: .45rem .85rem;
    transition: .2s;
    display: flex;
    align-items: center;
    gap: .4rem;
    text-decoration: none;
  }
  .nav-add-btn:hover {
    background: rgba(255,255,255,.22);
    color: #fff !important;
    text-decoration: none;
    transform: translateY(-1px);
  }
  .nav-user-btn {
    font-size: 1.25rem;
    padding: .3rem .7rem !important;
  }
  .nav-user-btn i { vertical-align: middle; }
  .lang-toggle-btn {
    background: rgba(255,255,255,.13);
    border: 1px solid rgba(255,255,255,.3);
    border-radius: 10px;
    color: rgba(255,255,255,.9);
    font-family: 'Cairo', sans-serif;
    font-weight: 800;
    font-size: .78rem;
    padding: .3rem .65rem;
    cursor: pointer;
    transition: .2s;
    letter-spacing: .5px;
  }
  .lang-toggle-btn:hover { background: rgba(255,255,255,.22); color: #fff; }
  .nav-segment {
    background: rgba(255,255,255,.10);
    border: 1px solid rgba(255,255,255,.12);
  }
  .nav-segment:hover,
  .nav-segment.active-item {
    background: rgba(232,160,176,.30) !important;
    border-color: rgba(255,255,255,.20);
  }
  .nav-requests {
    background: rgba(232,160,176,.20);
    border: 1px solid rgba(232,160,176,.30);
  }
  .nav-requests:hover { background: rgba(232,160,176,.34) !important; }
</style>

<%- include("./demo_banner") %>

<nav class="navbar navbar-expand-lg hero-nav">
  <a class="navbar-brand hero-brand" href="/">
    <span class="logo-badge">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 2 L10 13 C10 16.5 7 17.5 5.2 16 C3.5 14.5 4 12.5 6.2 12.2" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="10" cy="2" r="1.4" fill="white"/>
      </svg>
    </span>
    <span class="logo-name">Croshim Studio</span>
  </a>

  <button class="navbar-toggler hero-toggler" type="button" data-toggle="collapse"
    data-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false"
    aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="mainNavbar">
    <ul class="navbar-nav ml-auto hero-links">

      <li class="nav-item">
        <a class="nav-link hero-link" data-nav-path="/" href="/"><%= t.nav_home %></a>
      </li>

      <li class="nav-item dropdown">
        <a class="nav-link hero-link nav-segment dropdown-toggle" href="#" id="productsDropdown"
           role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">المنتجات</a>
        <div class="dropdown-menu" aria-labelledby="productsDropdown">
          <a class="dropdown-item" data-nav-path="/all_products" href="/all_products"><i class="fas fa-th-large"></i> تصفح المنتجات</a>
          <% if (isAuthenticated) { %>
            <a class="dropdown-item" data-nav-path="/dashboard" href="/dashboard"><i class="fas fa-box"></i> <%= t.nav_my_products %></a>
            <a class="dropdown-item" href="#" data-toggle="modal" data-target="#exampleModal3"><i class="fas fa-plus-circle"></i> <%= t.nav_add_product %></a>
          <% } %>
        </div>
      </li>

      <% if (isAuthenticated) { %>
        <li class="nav-item dropdown">
          <a class="nav-link hero-link nav-segment dropdown-toggle" href="#" id="patternsDropdown"
             role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">الباترونات</a>
          <div class="dropdown-menu" aria-labelledby="patternsDropdown">
            <a class="dropdown-item" data-nav-path="/pattern-builder" href="/pattern-builder"><i class="fas fa-book"></i> <%= t.nav_workbook %></a>
          </div>
        </li>
      <% } %>

      <li class="nav-item dropdown">
        <a class="nav-link hero-link nav-segment dropdown-toggle" href="#" id="moreDropdown"
           role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">المزيد</a>
        <div class="dropdown-menu" aria-labelledby="moreDropdown">
          <a class="dropdown-item" data-nav-path="/feedback" href="/feedback"><i class="fas fa-lightbulb"></i> <%= t.nav_feedback %></a>
          <a class="dropdown-item" href="/#about"><i class="fas fa-heart"></i> <%= t.nav_about %></a>
          <a class="dropdown-item" href="/#contact"><i class="fas fa-envelope"></i> <%= t.nav_contact %></a>
        </div>
      </li>


      <% if (!isAuthenticated) { %>
        <li class="nav-item">
          <a class="nav-link hero-link hero-link-cta" data-toggle="modal" data-target="#loginModal" href="#">
            <%= t.nav_login %>
          </a>
        </li>
      <% } %>

      <% if (isAuthenticated) { %>

        <li class="nav-item">
          <a class="nav-link hero-link nav-requests" data-nav-path="/access-requests" href="/access-requests">
            <i class="fas fa-user-friends"></i> طلبات الوصول
          </a>
        </li>

        <form id="magic-form" action="/logout" method="POST" style="display:none;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        </form>

        <li class="nav-item dropdown">
          <a class="nav-link hero-link nav-user-btn dropdown-toggle" href="#" id="userDropdown"
             role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fas fa-user-circle"></i>
          </a>
          <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
            <a class="dropdown-item" href="/profile">
              <i class="fas fa-user-edit"></i>
              <%= t.nav_profile %>
            </a>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href="#"
               onclick="event.preventDefault(); document.getElementById('magic-form').submit();">
              <i class="fas fa-sign-out-alt"></i>
              <%= t.nav_logout %>
            </a>
          </div>
        </li>

      <% } %>

      <li class="nav-item">
        <a class="nav-link hero-link" target="_blank" href="https://croshim.com/"><%= t.nav_store %></a>
      </li>

      <!-- Language toggle -->
      <li class="nav-item d-flex align-items-center" style="margin-left:6px;">
        <form action="/set-lang" method="POST" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="lang" value="<%= lang === 'ar' ? 'en' : 'ar' %>">
          <button type="submit" class="lang-toggle-btn"><%= t.nav_lang_switch %></button>
        </form>
      </li>

    </ul>
  </div>
</nav>

<script>
(function () {
  var path = window.location.pathname;

  document.querySelectorAll('[data-nav-path]').forEach(function (link) {
    var navPath = link.getAttribute('data-nav-path');
    var isActive = navPath === '/' ? path === '/' : path.startsWith(navPath);
    if (isActive) {
      link.classList.add('hero-link-active');
      link.classList.add('active-item');
      var item = link.closest('.nav-item');
      if (item) item.classList.add('active');
    }
  });

})();
</script>

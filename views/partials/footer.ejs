

<footer id="footer" class="site-footer" data-aos="fade-up">
  <div class="container">
    <div class="row footer-grid">

      <div class="col-md-3 footer-col">
        <div class="footer-brand">
          <span class="footer-title">CROCHET HUB</span>
          <p class="footer-tagline"><%= t.footer_tagline %></p>
        </div>
      </div>

      <div class="col-md-3 footer-col">
        <span class="footer-title"><%= t.footer_explore %></span>
        <ul class="footer-links">
          <li><a href="/"><%= t.footer_home %></a></li>
          <li><a href="#about"><%= t.footer_about %></a></li>
          <li><a href="/display_product"><%= t.footer_products %></a></li>
        </ul>
      </div>

      <div class="col-md-3 footer-col">
        <span class="footer-title"><%= t.footer_email_label %></span>
        <p class="footer-contact">
          <i class="fas fa-envelope"></i>
          <span>zwali.eng@gmail.com</span>
        </p>
      </div>

      <div class="col-md-3 footer-col">
        <span class="footer-title"><%= t.footer_follow %></span>
        <div class="footer-social">
          <a href="#" class="social-btn" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="#" class="social-btn" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
          <a href="#" class="social-btn" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <p class="copy">© <%= new Date().getFullYear() %> Croshim Studio. All rights reserved.</p>
    </div>
  </div>
</footer>

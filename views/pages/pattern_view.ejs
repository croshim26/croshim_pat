<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>

  <%- include("../partials/seo") %>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NCLMN2BEVN"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-NCLMN2BEVN');
  </script>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <style>
    <%
      const PV_THEMES = {
        rose:     { blush:'#F4C2C2', rose:'#E8839A', deepRose:'#C0516B', mauve:'#9B3A52', softPink:'#FAE4EA', petal:'#F9D4DC', cream:'#FDF0F3', textDark:'#5A2A38', textMid:'#8B4D60', textLight:'#B8798A', codeBg:'#FDF5F7', codeBorder:'#EEC5CF', grad:'linear-gradient(135deg,#F9D4DC 0%,#F0A8B8 40%,#E07A94 100%)' },
        lavender: { blush:'#D8C5F0', rose:'#B08CD5', deepRose:'#7B52BB', mauve:'#5B3A9B', softPink:'#EDE4F8', petal:'#E2D4F5', cream:'#F5F0FD', textDark:'#2D1A5A', textMid:'#5A3A8A', textLight:'#907AB8', codeBg:'#F5F0FD', codeBorder:'#CDB8E8', grad:'linear-gradient(135deg,#E2D4F5 0%,#C8A8E8 40%,#A87AD4 100%)' },
        sage:     { blush:'#C2D9C0', rose:'#7AB876', deepRose:'#4A8A46', mauve:'#2D6A2A', softPink:'#E4F0E2', petal:'#D4EDD2', cream:'#F0F8EF', textDark:'#1A3819', textMid:'#3A5A38', textLight:'#6A8A68', codeBg:'#F0F8EF', codeBorder:'#B8D8B6', grad:'linear-gradient(135deg,#D4EDD2 0%,#A8D8A4 40%,#7AB876 100%)' },
        ocean:    { blush:'#C0D8F0', rose:'#6AA8D8', deepRose:'#3A7AB8', mauve:'#1A4A8A', softPink:'#E0EEF8', petal:'#D0E8F5', cream:'#F0F5FD', textDark:'#0A2448', textMid:'#2A4A78', textLight:'#6A8AB0', codeBg:'#F0F5FD', codeBorder:'#B0D0E8', grad:'linear-gradient(135deg,#D0E8F5 0%,#A0C8E8 40%,#6AAAD0 100%)' },
        gold:     { blush:'#F0DCA8', rose:'#D4A840', deepRose:'#B07820', mauve:'#7A5010', softPink:'#F8EDD0', petal:'#F5E4C0', cream:'#FDF8ED', textDark:'#3A2808', textMid:'#6A4820', textLight:'#9A7848', codeBg:'#FDF8ED', codeBorder:'#E8CFA0', grad:'linear-gradient(135deg,#F5E4C0 0%,#E8C880 40%,#D4A840 100%)' },
        peach:    { blush:'#F0C8B0', rose:'#E0916A', deepRose:'#C06040', mauve:'#9A3820', softPink:'#F8E4D4', petal:'#F5D4C0', cream:'#FDF5F0', textDark:'#481808', textMid:'#7A3820', textLight:'#B07858', codeBg:'#FDF5F0', codeBorder:'#E8C0A8', grad:'linear-gradient(135deg,#F5D4C0 0%,#E8B090 40%,#D88060 100%)' },
      };
      const pvt = PV_THEMES[pattern.color_theme] || PV_THEMES.rose;
    %>
    :root {
      --blush:      <%= pvt.blush %>;
      --rose:       <%= pvt.rose %>;
      --deep-rose:  <%= pvt.deepRose %>;
      --mauve:      <%= pvt.mauve %>;
      --cream:      <%= pvt.cream %>;
      --soft-pink:  <%= pvt.softPink %>;
      --petal:      <%= pvt.petal %>;
      --text-dark:  <%= pvt.textDark %>;
      --text-mid:   <%= pvt.textMid %>;
      --text-light: <%= pvt.textLight %>;
      --code-bg:    <%= pvt.codeBg %>;
      --code-border:<%= pvt.codeBorder %>;
      --cover-grad: <%= pvt.grad %>;
    }

    body { background: var(--cream); }

    /* ── Action bar ── */
    .pv-bar {
      background: #fff;
      border-bottom: 1px solid var(--blush);
      padding: .6rem 1.2rem;
      display: flex;
      align-items: center;
      gap: .7rem;
      flex-wrap: wrap;
      box-shadow: 0 2px 8px rgba(155,58,90,.07);
      position: sticky; top: 0; z-index: 100;
    }
    .pv-brand {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.1rem;
      color: var(--mauve);
      font-weight: 700;
      text-decoration: none;
      flex-shrink: 0;
    }
    .pv-brand:hover { color: var(--deep-rose); text-decoration: none; }
    .pv-spacer { flex: 1; }
    .btn-pv {
      display: inline-flex; align-items: center; gap: .35rem;
      padding: .3rem .85rem; border-radius: 10px;
      font-size: .8rem; font-weight: 800;
      font-family: 'Cairo', sans-serif;
      border: 0; cursor: pointer; transition: .15s; text-decoration: none;
    }
    .btn-pv-print  { background: linear-gradient(135deg,#9b3a5a,#e8a0b0); color: #fff; }
    .btn-pv-print:hover  { filter: brightness(1.08); color: #fff; }
    .btn-pv-back   { background: rgba(155,58,90,.08); color: var(--mauve); border: 1px solid rgba(155,58,90,.18); }
    .btn-pv-back:hover   { background: rgba(155,58,90,.15); color: var(--mauve); }

    /* ── Page cards ── */
    .pages-wrap {
      max-width: 780px;
      margin: 32px auto;
      padding: 0 16px 60px;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .page {
      background: #fff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 6px 28px rgba(180,80,100,.11);
    }
    .cover-header {
      background: var(--cover-grad, linear-gradient(135deg,#F9D4DC 0%,#F0A8B8 40%,#E07A94 100%));
      padding: 26px 28px 18px; position: relative; overflow: hidden;
    }
    .cover-header::before {
      content:''; position:absolute; top:-50px; left:-50px;
      width:170px; height:170px; border-radius:50%; background:rgba(255,255,255,.14);
    }
    .cover-header::after {
      content:''; position:absolute; bottom:-32px; right:-32px;
      width:120px; height:120px; border-radius:50%; background:rgba(255,255,255,.09);
    }
    .brand-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; position:relative; z-index:1; }
    .brand-name { font-family:'Playfair Display',serif; font-style:italic; font-size:1.55rem; color:var(--mauve); letter-spacing:2px; }
    .brand-tagline { font-family:'Lato',sans-serif; font-size:.56rem; letter-spacing:4px; text-transform:uppercase; color:var(--deep-rose); margin-top:2px; }
    .yarn-icon { font-size:2rem; }
    .pattern-title-ar { font-family:'Noto Naskh Arabic',serif; font-size:1.6rem; font-weight:700; color:#fff; text-align:center; text-shadow:0 2px 10px rgba(155,58,82,.28); position:relative; z-index:1; }
    .pattern-subtitle-ar { font-family:'Noto Naskh Arabic',serif; font-size:.88rem; color:rgba(255,255,255,.87); text-align:center; margin-top:4px; position:relative; z-index:1; }
    .dots-deco { display:flex; gap:5px; padding:6px 16px 3px; justify-content:center; }
    .dots-deco span { width:6px; height:6px; border-radius:50%; display:inline-block; }
    .dots-deco span:nth-child(1){background:var(--blush);}
    .dots-deco span:nth-child(2){background:var(--rose);}
    .dots-deco span:nth-child(3){background:var(--blush);}
    .dots-deco span:nth-child(4){background:var(--petal);}
    .dots-deco span:nth-child(5){background:var(--rose);}
    .dots-deco span:nth-child(6){background:var(--blush);}
    .page-body { padding: 16px 28px 22px; }
    .section-pill { display:inline-flex; align-items:center; gap:7px; background:linear-gradient(135deg,var(--petal),var(--blush)); color:var(--mauve); font-family:'Noto Naskh Arabic',serif; font-weight:700; font-size:.92rem; padding:5px 12px 5px 10px; border-radius:50px; margin-bottom:9px; border:1.5px solid var(--rose); width:100%; justify-content:flex-end; }
    .subsection-label { font-family:'Noto Naskh Arabic',serif; font-size:.88rem; font-weight:600; color:var(--deep-rose); margin:10px 0 5px; padding-right:10px; border-right:3px solid var(--rose); text-align:right; }
    .code-card { background:var(--code-bg); border:1.5px solid var(--code-border); border-radius:11px; padding:9px 13px; margin-bottom:7px; direction:ltr; text-align:left; position:relative; overflow:hidden; }
    .code-card::before { content:''; position:absolute; top:0; right:0; width:4px; height:100%; background:linear-gradient(180deg,var(--rose),var(--blush)); border-radius:0 11px 11px 0; }
    .code-card code { font-family:'Courier New',monospace; font-size:.78rem; color:var(--text-dark); line-height:1.9; display:block; white-space:pre-wrap; word-break:break-word; }
    .note-box { background:linear-gradient(135deg,var(--cream),var(--petal)); border:1px solid var(--blush); border-radius:9px; padding:7px 11px; margin:5px 0 3px; display:flex; align-items:flex-start; gap:7px; flex-direction:row-reverse; font-family:'Noto Naskh Arabic',serif; font-size:.83rem; color:var(--text-mid); text-align:right; }
    .note-star { font-size:.93rem; flex-shrink:0; }
    .tools-table { width:100%; border-collapse:separate; border-spacing:0 4px; text-align:right; font-family:'Noto Naskh Arabic',serif; }
    .tools-table td { padding:5px 11px; font-size:.81rem; }
    .tools-table tr:nth-child(odd)  td { background:var(--soft-pink); }
    .tools-table tr:nth-child(even) td { background:var(--petal); }
    .tools-table td:last-child { border-radius:7px 0 0 7px; font-weight:600; color:var(--mauve); }
    .tools-table td:first-child { border-radius:0 7px 7px 0; color:var(--text-light); font-size:.76rem; }
    .abbr-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:5px; }
    .abbr-item { background:var(--soft-pink); border-radius:9px; padding:5px 9px; display:flex; align-items:center; gap:7px; border:1px solid var(--code-border); }
    .abbr-key { font-family:'Courier New',monospace; font-weight:bold; font-size:.77rem; color:var(--deep-rose); background:#fff; border-radius:5px; padding:2px 6px; border:1px solid var(--blush); flex-shrink:0; min-width:36px; text-align:center; }
    .abbr-val { font-family:'Lato',sans-serif; font-size:.71rem; color:var(--text-mid); direction:ltr; text-align:left; }
    .heart-divider { display:flex; align-items:center; gap:10px; padding:0 28px; }
    .heart-divider::before,.heart-divider::after { content:''; flex:1; height:1px; background:linear-gradient(90deg,transparent,var(--blush),transparent); }
    .heart-center { font-size:.92rem; color:var(--rose); }
    .page-footer { background:linear-gradient(135deg,var(--petal),var(--blush)); padding:8px 28px; display:flex; align-items:center; justify-content:space-between; }
    .footer-brand { font-family:'Playfair Display',serif; font-style:italic; font-size:.88rem; color:var(--mauve); }
    .footer-tagline { font-family:'Lato',sans-serif; font-size:.53rem; letter-spacing:3px; text-transform:uppercase; color:var(--deep-rose); }
    .footer-hearts { font-size:.78rem; letter-spacing:3px; }
    .footer-page-num { font-family:'Lato',serif; font-size:.78rem; color:var(--text-light); }

    /* ── Print ── */
    @media print {
      @page { size: A4 portrait; margin: 0; }
      *, *::before, *::after {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        animation: none !important; transition: none !important;
      }
      .pv-bar { display: none !important; }
      body { background: #fff !important; }
      .pages-wrap { max-width: 100% !important; margin: 0 !important; padding: 0 !important; gap: 0 !important; }
      .page {
        width: 210mm !important; min-height: 297mm !important; max-height: 297mm !important;
        overflow: hidden !important; box-shadow: none !important; border-radius: 0 !important;
        page-break-after: always !important; break-after: page !important;
        page-break-inside: avoid !important; break-inside: avoid !important;
        display: flex !important; flex-direction: column !important;
      }
      .page:last-child { page-break-after: avoid !important; break-after: avoid !important; }
      .page-body { flex: 1 !important; }
      .pattern-title-ar, .pattern-subtitle-ar, .section-pill,
      .subsection-label, .note-box, .tools-table td {
        font-family: 'Noto Naskh Arabic', 'Cairo', serif !important; direction: rtl !important;
      }
      .code-card, .code-card code, .abbr-key {
        direction: ltr !important; text-align: left !important;
        font-family: 'Courier New', monospace !important;
      }
      .brand-name, .footer-brand { font-family: 'Playfair Display', serif !important; }
      img { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      #lightbox { display: none !important; }
    }
  </style>
</head>
<body>

<%- include("../partials/demo_banner") %>

<!-- Action bar -->
<div class="pv-bar">
  <a class="pv-brand" href="/">croshim</a>
  <span class="pv-spacer"></span>
  <button class="btn-pv btn-pv-print" onclick="window.print()">
    <i class="fas fa-print"></i> <%= t.pv_print_btn %>
  </button>
  <% if (isAuthenticated) { %>
  <a class="btn-pv btn-pv-back" href="/pattern-builder?load=<%= pattern.id %>">
    <i class="fas fa-magic"></i> <%= t.pv_open_builder %>
  </a>
  <% } %>
  <a class="btn-pv btn-pv-back" href="/dashboard">
    <i class="fas fa-arrow-left"></i> <%= t.pv_back %>
  </a>
</div>

<div class="pages-wrap">

  <%
    const PARTS_PER_PAGE = 4;
    const emoji = pattern.emoji || '🧶';
    const hasCover = !!pattern.cover_image;
    const chunks = [];
    for (let i = 0; i < parts.length; i += PARTS_PER_PAGE) chunks.push(parts.slice(i, i + PARTS_PER_PAGE));
    const totalPages = chunks.length + (hasCover ? 2 : 1);
  %>

  <!-- Cover page (only when cover image exists) -->
  <% if (hasCover) { %>
  <div class="page" style="min-height:500px;display:flex;flex-direction:column;">
    <div class="cover-header" style="flex:1;padding:40px 32px;display:flex;flex-direction:column;justify-content:center;align-items:center;">
      <div style="position:relative;z-index:1;text-align:center;width:100%;margin-bottom:6px;">
        <div class="brand-name" style="font-size:1.75rem;">croshim</div>
        <div class="brand-tagline" style="margin-bottom:22px;">crochet with heart</div>
      </div>
      <div style="position:relative;z-index:1;display:flex;justify-content:center;margin-bottom:22px;">
        <img src="<%= pattern.cover_image %>" alt="cover"
          style="width:200px;height:200px;object-fit:cover;border-radius:50%;
                 border:5px solid rgba(255,255,255,.8);box-shadow:0 10px 40px rgba(155,58,82,.3);">
      </div>
      <div style="position:relative;z-index:1;text-align:center;">
        <div class="pattern-title-ar" style="font-size:1.75rem;"><%= pattern.name %></div>
        <% if (pattern.subtitle) { %><div class="pattern-subtitle-ar"><%= pattern.subtitle %></div><% } %>
      </div>
    </div>
    <div class="dots-deco"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="heart-divider" style="margin:0 28px;"><span class="heart-center">🤍</span></div>
    <div class="page-footer">
      <div><div class="footer-brand">croshim</div><div class="footer-tagline">crochet with heart</div></div>
      <div class="footer-hearts">🤍 🤍 🤍</div>
      <div class="footer-page-num">١ / <%= totalPages %></div>
    </div>
  </div>
  <% } %>

  <!-- Tools + Abbreviations page -->
  <div class="page">
    <div class="cover-header">
      <div class="brand-row">
        <div><div class="brand-name">croshim</div><div class="brand-tagline">crochet with heart</div></div>
        <div class="yarn-icon"><%= emoji %></div>
      </div>
      <div class="pattern-title-ar"><%= pattern.name %></div>
      <% if (pattern.subtitle) { %><div class="pattern-subtitle-ar"><%= pattern.subtitle %></div><% } %>
    </div>
    <div class="dots-deco"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="page-body">
      <% if (tools.filter(tool => tool.name).length) { %>
      <div class="section-pill"><span>🧶</span> <%= t.pdf_section_tools %></div>
      <table class="tools-table">
        <% tools.filter(tool => tool.name).forEach(function(tool) { %>
          <tr><td><%= tool.detail || '' %></td><td><%= tool.name %></td></tr>
        <% }); %>
      </table>
      <div style="height:14px;"></div>
      <% } %>
      <div class="section-pill"><span>📋</span> <%= t.pdf_section_abbrs %></div>
      <div class="abbr-grid">
        <% allAbbrs.forEach(function(a) { %>
          <div class="abbr-item">
            <span class="abbr-key"><%= a.key %></span>
            <span class="abbr-val"><%= a.val %></span>
          </div>
        <% }); %>
      </div>
    </div>
    <div class="heart-divider"><span class="heart-center">🤍</span></div>
    <div class="page-footer">
      <div><div class="footer-brand">croshim</div><div class="footer-tagline">crochet with heart</div></div>
      <div class="footer-hearts">🤍 🤍 🤍</div>
      <div class="footer-page-num"><%= hasCover ? 2 : 1 %> / <%= totalPages %></div>
    </div>
  </div>

  <!-- Parts pages -->
  <% chunks.forEach(function(chunk, ci) { %>
  <% var pageNum = ci + (hasCover ? 3 : 2); %>
  <div class="page">
    <div class="cover-header" style="padding:16px 28px;">
      <div class="brand-row" style="margin-bottom:0;">
        <div class="brand-name" style="font-size:1.15rem;">croshim</div>
        <div style="text-align:center;flex:1;">
          <div class="pattern-title-ar" style="font-size:1.25rem;"><%= emoji %> <%= pattern.name %></div>
        </div>
        <div class="yarn-icon" style="font-size:1.55rem;">🧶</div>
      </div>
    </div>
    <div class="dots-deco"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="page-body">
      <% chunk.forEach(function(p) { %>
        <% if (p.name) { %><div class="subsection-label"><%= p.name %></div><% } %>
        <%
          var partImgs = (p.imgs && p.imgs.length) ? p.imgs : (p.img ? [p.img] : []);
        %>
        <% if (partImgs.length) { %>
          <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;margin-bottom:8px;">
            <% partImgs.forEach(function(src) { %>
              <img src="<%= src %>" class="part-photo" style="height:140px;max-width:190px;object-fit:cover;border-radius:9px;border:2px solid var(--blush);transition:transform .15s,box-shadow .15s;" onmouseover="this.style.transform='scale(1.04)';this.style.boxShadow='0 6px 20px rgba(155,58,90,.25)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
            <% }); %>
          </div>
        <% } %>
        <% if (p.code) { %>
          <div class="code-card"><code><%= p.code %></code></div>
        <% } %>
        <% if (p.note) { %>
          <div class="note-box"><span class="note-star">⭐</span><%= p.note %></div>
        <% } %>
      <% }); %>
    </div>
    <div class="heart-divider"><span class="heart-center">🤍</span></div>
    <div class="page-footer">
      <div><div class="footer-brand">croshim</div><div class="footer-tagline">crochet with heart</div></div>
      <div class="footer-hearts">🤍 🤍 🤍</div>
      <div class="footer-page-num"><%= pageNum %> / <%= totalPages %></div>
    </div>
  </div>
  <% }); %>

</div>

<div id="lightbox" onclick="closeLightbox()" style="
  display:none; position:fixed; inset:0; z-index:9999;
  background:rgba(0,0,0,.88); backdrop-filter:blur(6px);
  align-items:center; justify-content:center; cursor:zoom-out;">
  <img id="lightbox-img" src="" alt="" style="
    max-width:92vw; max-height:92vh; object-fit:contain;
    border-radius:12px; box-shadow:0 20px 60px rgba(0,0,0,.6);
    user-select:none;">
  <button onclick="closeLightbox()" style="
    position:fixed; top:18px; left:18px; background:rgba(255,255,255,.15);
    border:1.5px solid rgba(255,255,255,.3); border-radius:50%;
    width:38px; height:38px; color:#fff; font-size:1.1rem;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    backdrop-filter:blur(4px); transition:.15s;" onmouseover="this.style.background='rgba(255,255,255,.25)'" onmouseout="this.style.background='rgba(255,255,255,.15)'">✕</button>
</div>

<script>
(function () {
  document.querySelectorAll('.part-photo').forEach(function (img) {
    img.style.cursor = 'zoom-in';
    img.addEventListener('click', function () {
      document.getElementById('lightbox-img').src = this.src;
      var lb = document.getElementById('lightbox');
      lb.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    });
  });
})();

function closeLightbox() {
  document.getElementById('lightbox').style.display = 'none';
  document.getElementById('lightbox-img').src = '';
  document.body.style.overflow = '';
}

document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') closeLightbox();
});
</script>

<script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
</body>
</html>

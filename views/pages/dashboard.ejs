<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">

<head>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NCLMN2BEVN"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-NCLMN2BEVN');
  </script>
  <meta charset="utf-8">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Croshim Studio | <%= t.my_products_title %></title>
  <!-- Private page: keep it out of search results -->
  <meta name="robots" content="noindex, nofollow">

  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css">

  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/pages/products.css">
</head>

<body>

  <%- include("../partials/navbar") %>

  <main class="products-page">
    <div class="container">

      <% if (success_message) { %>
        <div class="alert alert-success alert-dismissible fade show hero-alert mt-3" role="alert">
          <strong><%= t.alert_success_prefix %></strong> <%= success_message %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>
      <% if (error_message) { %>
        <div class="alert alert-danger alert-dismissible fade show hero-alert mt-3" role="alert">
          <strong><%= t.alert_error_prefix %></strong> <%= error_message %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>

      <div class="welcome-banner" data-aos="fade-up">
        <div class="welcome-info">
          <div class="welcome-avatar">
            <i class="fas fa-user"></i>
          </div>
          <div>
            <h2 class="welcome-name">
              <%= t.welcome_greeting %> <%= currentUser.firstName %> <%= currentUser.lastName %>
            </h2>
            <p class="welcome-sub"><%= t.manage_subtitle %></p>
          </div>
        </div>
        <div class="welcome-stat">
          <span class="stat-count"><%= products ? products.length : 0 %></span>
          <span class="stat-label"><%= t.stat_label %></span>
        </div>
      </div>

      <header class="page-header" data-aos="fade-up">
        <h1 class="products-title"><%= t.my_products_title %></h1>
        <p class="products-subtitle"><%= t.products_subtitle %></p>
      </header>

      <div class="row">

        <% if (products && products.length > 0) { %>

          <% products.forEach(function(product, index) { %>

            <div class="col-12 col-sm-6 col-md-4 mb-4" data-aos="fade-up" data-aos-delay="<%= index * 60 %>">
              <article class="card product-card">

                                <%
                  /* cover_image is user-supplied (saved from the builder), so only
                     real image sources are allowed through into src. */
                  const rawCover = (product.pattern && product.pattern.cover_image) || "";
                  const cover = /^(https?:\/\/|data:image\/)/i.test(rawCover) ? rawCover : null;
                  const coverEmoji = (product.pattern && product.pattern.emoji) || "🧶";
                %>
                <% if (cover) { %>
                  <img
                    src="<%= cover %>"
                    alt="<%= (product.pattern && product.pattern.name) || product.product_name || "" %>"
                    class="product-cover"
                    loading="lazy"
                    onerror="this.onerror=null;this.hidden=true;if(this.nextElementSibling){this.nextElementSibling.hidden=false;}"
                  >
                  <!-- shown only if the image 404s (e.g. dead storage URL) -->
                  <div class="product-cover-placeholder" hidden><span><%= coverEmoji %></span></div>
                <% } else { %>
                  <div class="product-cover-placeholder"><span><%= coverEmoji %></span></div>
                <% } %>



                <div class="product-header">
                  <span class="label-title"><%= t.label_product_name %></span>
                  <h2 class="product-name"><%= product.product_name %></h2>

                </div>

                <div class="product-body">

                  <div class="product-meta">
                    <span class="label-title"><%= t.label_product_desc %></span>
                    <p class="product-description"><%= product.product_description %></p>
                  </div>

                  <div class="product-meta">
                    <span class="label-title"><%= t.label_product_file %></span>

                    <% if (product.pdf_path) { %>
                      <a href="<%= product.pdf_path %>" target="_blank"
                        class="btn pdf-btn" rel="noopener noreferrer">
                        <i class="fas fa-file-pdf"></i>
                        <%= t.btn_view_file %>
                      </a>
                    <% } else { %>
                      <div class="no-file">
                        <i class="far fa-folder-open"></i>
                        <%= t.no_file %>
                      </div>
                    <% } %>
                  </div>

                  

<div class="product-visibility">
                    <span class="label-title"><%= t.dash_visibility_label %></span>

                    <div class="vis-row">
                      <span class="vis-state <%= product.is_published ? "is-on" : "is-off" %>">
                        <i class="fas <%= product.is_published ? "fa-eye" : "fa-eye-slash" %>"></i>
                        <%= t.dash_product_label %>:
                        <%= product.is_published ? t.dash_status_published : t.dash_status_hidden %>
                      </span>
                      <form action="/products/<%= product.id %>/toggle-published" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="vis-toggle <%= product.is_published ? "to-hide" : "to-publish" %>">
                          <i class="fas <%= product.is_published ? "fa-eye-slash" : "fa-eye" %>"></i>
                          <%= product.is_published ? t.btn_unpublish_product : t.btn_publish_product %>
                        </button>
                      </form>
                    </div>

                    <%
                      /* The second flag currently gates whichever file the card
                         links to, so label it after what this product actually
                         has: a builder pattern, or an uploaded PDF. */
                      const hasPattern = Boolean(product.pattern);
                      const fileLabel = hasPattern ? t.dash_pattern_label : t.dash_file_label;
                      const publishLabel = hasPattern ? t.btn_publish_pattern : t.btn_publish_file;
                      const hideLabel = hasPattern ? t.btn_unpublish_pattern : t.btn_unpublish_file;
                    %>
                    <div class="vis-row">
                      <span class="vis-state <%= product.is_pattern_published ? "is-on" : "is-off" %>">
                        <i class="fas <%= product.is_pattern_published ? "fa-eye" : "fa-eye-slash" %>"></i>
                        <%= fileLabel %>:
                        <%= product.is_pattern_published ? t.dash_status_published : t.dash_status_hidden %>
                      </span>
                      <form action="/products/<%= product.id %>/toggle-pattern-published" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="vis-toggle <%= product.is_pattern_published ? "to-hide" : "to-publish" %>">
                          <i class="fas <%= product.is_pattern_published ? "fa-eye-slash" : "fa-eye" %>"></i>
                          <%= product.is_pattern_published ? hideLabel : publishLabel %>
                        </button>
                      </form>
                    </div>

                    <% if (!product.is_published) { %>
                      <p class="vis-hint"><%= t.dash_hidden_hint %></p>
                    <% } %>
                  </div>


                  <form action="/delete_product/<%= product.id %>" method="POST"
                    class="delete-product-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn delete-btn btn-block"
                      onclick="return confirm('<%= t.confirm_delete_product %>');">
                      <i class="fas fa-trash-alt"></i>
                      <%= t.btn_delete_product %>
                    </button>
                  </form>

                </div>

              </article>
            </div>

          <% }) %>

        <% } else { %>

          <div class="col-12" data-aos="fade-up">
            <div class="empty-state">
              <i class="fas fa-box-open empty-icon"></i>
              <h5><%= t.no_products_title %></h5>
              <p><%= t.no_products_desc %></p>
              <a href="#" class="btn pdf-btn mt-3" data-toggle="modal" data-target="#exampleModal3">
                <i class="fas fa-plus"></i> <%= t.btn_add_first %>
              </a>
            </div>
          </div>

        <% } %>

      </div>
    </div>
  </main>

  <%- include("../partials/add_product") %>
  <%- include("../partials/footer") %>

  <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
  <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
  <script>AOS.init({ once: true, duration: 500 });</script>

</body>

</html>

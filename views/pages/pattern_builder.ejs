<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pattern Builder — Croshim Studio</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <style>
    html, body { height: 100%; overflow: hidden; }

    .pb-shell {
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    /* ── Top bar ── */
    .pb-topbar {
      background: #fff;
      border-bottom: 1px solid rgba(155,58,90,.12);
      padding: .5rem 1rem;
      display: flex;
      align-items: center;
      gap: .75rem;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(155,58,90,.06);
    }
    .pb-topbar-brand {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.15rem;
      color: #9b3a5a;
      font-weight: 700;
      text-decoration: none;
      flex-shrink: 0;
    }
    .pb-topbar-brand:hover { color: #6b1a30; text-decoration: none; }
    .pb-topbar-title {
      font-family: 'Cairo', sans-serif;
      font-weight: 900;
      font-size: .85rem;
      color: #6b1a30;
      background: rgba(155,58,90,.08);
      border-radius: 20px;
      padding: .2rem .7rem;
    }
    .pb-topbar-back {
      margin-right: auto;
      font-size: .8rem;
      font-weight: 800;
      color: #9e677a;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: .3rem;
      transition: color .15s;
    }
    .pb-topbar-back:hover { color: #9b3a5a; text-decoration: none; }

    /* ── Saved strip ── */
    .saved-strip {
      background: #fff8f9;
      border-bottom: 1px solid rgba(155,58,90,.1);
      padding: .45rem 1rem;
      display: flex;
      align-items: center;
      gap: .6rem;
      flex-shrink: 0;
    }
    .saved-strip-label {
      font-size: .74rem; font-weight: 900; color: #9b3a5a;
      white-space: nowrap; display: flex; align-items: center; gap: .3rem;
      flex-shrink: 0;
    }
    .saved-chips {
      display: flex; gap: .4rem; overflow-x: auto; flex: 1;
      scrollbar-width: none;
    }
    .saved-chips::-webkit-scrollbar { display: none; }
    .saved-chip {
      display: inline-flex; align-items: center; gap: .35rem;
      background: rgba(155,58,90,.08); border: 1px solid rgba(155,58,90,.15);
      border-radius: 20px; padding: .2rem .6rem;
      font-size: .75rem; font-weight: 800; color: #6b1a30;
      white-space: nowrap; cursor: pointer; transition: .15s; flex-shrink: 0;
    }
    .saved-chip:hover { background: rgba(155,58,90,.16); }
    .saved-chip.active-chip { background: rgba(155,58,90,.22); border-color: #9b3a5a; }
    .chip-del {
      color: #b91c1c; font-size: .67rem; opacity: .65;
      cursor: pointer; padding: 1px 3px; border-radius: 4px;
    }
    .chip-del:hover { opacity: 1; background: rgba(220,38,38,.1); }
    .chip-share {
      color: #0369a1; font-size: .67rem; opacity: .65;
      text-decoration: none; padding: 1px 3px; border-radius: 4px; transition: .15s;
    }
    .chip-share:hover { opacity: 1; background: rgba(3,105,161,.1); }
    .saved-empty { font-size: .74rem; color: #9e677a; font-weight: 700; white-space: nowrap; }

    .strip-actions { display: flex; gap: .4rem; flex-shrink: 0; }
    .btn-strip {
      display: inline-flex; align-items: center; gap: .3rem;
      padding: .26rem .7rem; border-radius: 10px; font-weight: 800;
      font-size: .74rem; border: 0; cursor: pointer; transition: .15s;
      font-family: 'Cairo', sans-serif;
    }
    .btn-strip-save  { background: linear-gradient(135deg,#9b3a5a,#e8a0b0); color: #fff; }
    .btn-strip-save:hover  { filter: brightness(1.08); }
    .btn-strip-new   { background: rgba(155,58,90,.1); color: #9b3a5a; border: 1px solid rgba(155,58,90,.2); }
    .btn-strip-new:hover   { background: rgba(155,58,90,.18); }
    .btn-strip-print   { background: rgba(34,197,94,.1);  color: #166534; border: 1px solid rgba(34,197,94,.2); }
    .btn-strip-print:hover   { background: rgba(34,197,94,.18); }
    .btn-strip-dash  { background: rgba(109,40,217,.1); color: #5b21b6; border: 1px solid rgba(109,40,217,.22); }
    .btn-strip-dash:hover { background: rgba(109,40,217,.18); }
    #toast a { color: #e8d5ff; text-decoration: underline; }
    #toast a:hover { color: #fff; }

    /* ── Toast ── */
    #toast {
      position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%) translateY(80px);
      background: #1a1a1a; color: #fff; padding: .6rem 1.2rem;
      border-radius: 12px; font-size: .85rem; font-weight: 700;
      font-family: 'Cairo', sans-serif; z-index: 9999;
      transition: transform .3s ease, opacity .3s ease; opacity: 0;
    }
    #toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

    /* ── Builder area ── */
    .builder-area {
      flex: 1; overflow: hidden;
      display: grid;
      grid-template-columns: 370px 1fr;
    }

    /* Brand tokens */
    .builder-area {
      --blush:     #F4C2C2;
      --rose:      #E8839A;
      --deep-rose: #C0516B;
      --mauve:     #9B3A52;
      --cream:     #FDF0F3;
      --soft-pink: #FAE4EA;
      --petal:     #F9D4DC;
      --text-dark: #5A2A38;
      --text-mid:  #8B4D60;
      --text-light:#B8798A;
      --code-bg:   #FDF5F7;
      --code-border:#EEC5CF;
      --cover-grad: linear-gradient(135deg,#F9D4DC 0%,#F0A8B8 40%,#E07A94 100%);
    }

    .theme-swatches { display:flex; gap:8px; margin-bottom:8px; flex-wrap:wrap; }
    .theme-swatch {
      width:26px; height:26px; border-radius:50%; border:2.5px solid transparent;
      cursor:pointer; transition:transform .15s, border-color .15s;
      box-shadow:0 2px 6px rgba(0,0,0,.14); padding:0;
    }
    .theme-swatch:hover { transform:scale(1.18); }
    .theme-swatch.active { border-color:var(--text-dark); transform:scale(1.12); box-shadow:0 0 0 3px rgba(0,0,0,.1); }

    /* ── Builder panel ── */
    .builder-panel {
      background: #fff;
      border-left: 1px solid var(--blush);
      padding: 16px 14px 36px;
      overflow-y: auto;
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .builder-logo {
      font-family: 'Playfair Display', serif; font-style: italic;
      font-size: 1.4rem; color: var(--mauve); text-align: center; margin-bottom: 2px;
    }
    .builder-sub {
      font-family: 'Lato', sans-serif; font-size: .57rem;
      letter-spacing: 4px; text-transform: uppercase; color: var(--rose);
      text-align: center; margin-bottom: 12px;
    }
    .builder-divider {
      height: 1px; background: linear-gradient(90deg, transparent, var(--blush), transparent);
      margin-bottom: 12px;
    }
    .b-section { margin-bottom: 12px; }
    .b-section-title {
      font-size: .71rem; font-weight: 700; color: var(--deep-rose);
      letter-spacing: 2px; text-transform: uppercase;
      font-family: 'Lato', sans-serif; margin-bottom: 7px;
      display: flex; align-items: center; gap: 6px;
    }
    .b-section-title::after { content: ''; flex: 1; height: 1px; background: var(--blush); }
    .b-label {
      display: block; font-size: .77rem; color: var(--text-mid);
      margin-bottom: 3px; text-align: right;
      font-family: 'Noto Naskh Arabic', serif;
    }
    .b-input, .b-textarea, .b-select {
      width: 100%; background: var(--soft-pink);
      border: 1.5px solid var(--blush); border-radius: 9px;
      padding: 6px 10px; font-family: 'Noto Naskh Arabic', 'Lato', serif;
      font-size: .83rem; color: var(--text-dark); outline: none;
      text-align: right; direction: rtl; transition: border-color .2s;
      margin-bottom: 7px;
    }
    .b-input:focus, .b-textarea:focus { border-color: var(--rose); background: #fff; }
    .b-textarea {
      resize: vertical; min-height: 65px;
      font-family: 'Courier New', monospace; font-size: .77rem;
      direction: ltr; text-align: left;
    }
    .b-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

    .part-block {
      background: var(--soft-pink); border: 1.5px solid var(--blush);
      border-radius: 11px; padding: 9px 11px; margin-bottom: 7px; position: relative;
    }
    .part-block-head {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 5px; gap: 6px;
    }
    .part-name-input { flex: 1; background: #fff !important; margin-bottom: 0 !important; }
    .btn-remove {
      background: none; border: none; color: var(--rose);
      cursor: pointer; font-size: .95rem; padding: 2px 5px;
      border-radius: 5px; transition: background .2s; flex-shrink: 0;
    }
    .btn-remove:hover { background: var(--petal); }
    .part-note-input {
      font-family: 'Noto Naskh Arabic', 'Lato', serif !important;
      direction: rtl !important; text-align: right !important;
      min-height: 36px !important;
    }
    .btn-add-part {
      width: 100%; background: linear-gradient(135deg, var(--petal), var(--blush));
      border: 2px dashed var(--rose); border-radius: 10px; padding: 7px;
      color: var(--mauve); font-family: 'Lato', sans-serif; font-size: .77rem;
      letter-spacing: 1px; cursor: pointer; transition: all .2s; margin-bottom: 10px;
    }
    .btn-add-part:hover { background: var(--petal); transform: translateY(-1px); }
    .btn-generate {
      width: 100%; background: linear-gradient(135deg, var(--rose), var(--deep-rose));
      border: none; border-radius: 12px; padding: 11px;
      color: #fff; font-family: 'Lato', sans-serif; font-size: .84rem;
      letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: all .2s;
      margin-top: 4px;
    }
    .btn-generate:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(180,80,100,.28); }

    .img-upload-zone {
      border: 2px dashed var(--rose); border-radius: 12px; padding: 13px 10px;
      text-align: center; background: var(--soft-pink); cursor: pointer;
      transition: all .2s; margin-bottom: 4px; position: relative;
    }
    .img-upload-zone:hover { background: var(--petal); border-color: var(--deep-rose); }
    .img-upload-zone input[type=file] {
      position: absolute; inset: 0; opacity: 0; cursor: pointer;
      width: 100%; height: 100%; border: none; background: none; margin: 0; padding: 0;
    }
    .img-upload-label {
      font-family: 'Noto Naskh Arabic', serif; font-size: .79rem;
      color: var(--text-mid); pointer-events: none;
    }
    .img-upload-label span { display: block; font-size: 1.3rem; margin-bottom: 3px; }
    .img-preview-thumb {
      width: 100%; max-height: 90px; object-fit: cover;
      border-radius: 8px; margin-top: 6px; border: 2px solid var(--blush); display: none;
    }
    .btn-remove-img {
      display: none; width: 100%; background: none;
      border: 1.5px solid var(--blush); border-radius: 7px; padding: 4px;
      color: var(--rose); font-size: .73rem; cursor: pointer; margin-top: 4px;
      font-family: 'Lato', sans-serif;
    }
    .btn-remove-img:hover { background: var(--petal); }

    .part-img-zone {
      border: 2px dashed var(--blush); border-radius: 9px; padding: 7px 10px;
      text-align: center; background: var(--code-bg); cursor: pointer;
      transition: all .2s; margin-top: 5px; position: relative;
    }
    .part-img-zone:hover { border-color: var(--rose); background: var(--soft-pink); }
    .part-img-zone.has-img { border-color: var(--deep-rose); }
    .part-img-zone input[type=file] {
      position: absolute; inset: 0; opacity: 0; cursor: pointer;
      width: 100%; height: 100%; border: none; background: none; margin: 0; padding: 0;
    }
    .part-img-zone-label {
      font-family: 'Noto Naskh Arabic', serif; font-size: .72rem;
      color: var(--text-light); pointer-events: none;
    }
    .part-imgs-grid {
      display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 5px;
    }
    .part-imgs-grid .part-thumb-wrap {
      position: relative; display: inline-block;
    }
    .part-imgs-grid img {
      width: 72px; height: 72px; object-fit: cover;
      border-radius: 8px; border: 1.5px solid var(--blush); display: block;
    }
    .part-thumb-del {
      position: absolute; top: -5px; right: -5px;
      width: 18px; height: 18px; border-radius: 50%;
      background: #fff; border: 1.5px solid var(--rose); color: var(--rose);
      font-size: .58rem; cursor: pointer; display: flex;
      align-items: center; justify-content: center; padding: 0;
      font-family: 'Lato', sans-serif; font-weight: 900; line-height: 1;
    }
    .part-thumb-del:hover { background: var(--petal); }

    /* ── Preview panel ── */
    .preview-panel {
      padding: 20px 16px; overflow-y: auto;
      background: var(--cream); height: 100%;
    }
    .preview-placeholder {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; height: 60vh; color: var(--text-light);
      gap: 10px; text-align: center;
    }
    .preview-placeholder .ph-icon { font-size: 3.2rem; }
    .preview-placeholder p { font-family: 'Noto Naskh Arabic', serif; font-size: .92rem; }

    /* ── Pattern pages ── */
    .page {
      background: #fff; border-radius: 16px; overflow: hidden;
      margin-bottom: 20px; box-shadow: 0 6px 28px rgba(180,80,100,.11);
    }
    .cover-header {
      background: var(--cover-grad, linear-gradient(135deg,#F9D4DC 0%,#F0A8B8 40%,#E07A94 100%));
      padding: 26px 28px 18px; position: relative; overflow: hidden;
    }
    .cover-header::before {
      content:''; position:absolute; top:-50px; left:-50px;
      width:170px; height:170px; border-radius:50%; background:rgba(255,255,255,.14);
    }
    .cover-header::after {
      content:''; position:absolute; bottom:-32px; right:-32px;
      width:120px; height:120px; border-radius:50%; background:rgba(255,255,255,.09);
    }
    .brand-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; position:relative; z-index:1; }
    .brand-name { font-family:'Playfair Display',serif; font-style:italic; font-size:1.55rem; color:var(--mauve); letter-spacing:2px; }
    .brand-tagline { font-family:'Lato',sans-serif; font-size:.56rem; letter-spacing:4px; text-transform:uppercase; color:var(--deep-rose); margin-top:2px; }
    .yarn-icon { font-size:2rem; animation:wobble 3s ease-in-out infinite; }
    @keyframes wobble{0%,100%{transform:rotate(-5deg)}50%{transform:rotate(5deg)}}
    .pattern-title-ar { font-family:'Noto Naskh Arabic',serif; font-size:1.6rem; font-weight:700; color:#fff; text-align:center; text-shadow:0 2px 10px rgba(155,58,82,.28); position:relative; z-index:1; }
    .pattern-subtitle-ar { font-family:'Noto Naskh Arabic',serif; font-size:.88rem; color:rgba(255,255,255,.87); text-align:center; margin-top:4px; position:relative; z-index:1; }

    .dots-deco { display:flex; gap:5px; padding:6px 16px 3px; justify-content:center; }
    .dots-deco span { width:6px; height:6px; border-radius:50%; display:inline-block; animation:dotPulse 1.8s ease-in-out infinite; }
    .dots-deco span:nth-child(1){background:var(--blush);}
    .dots-deco span:nth-child(2){background:var(--rose);animation-delay:.15s;}
    .dots-deco span:nth-child(3){background:var(--blush);animation-delay:.3s;}
    .dots-deco span:nth-child(4){background:var(--petal);animation-delay:.45s;}
    .dots-deco span:nth-child(5){background:var(--rose);animation-delay:.6s;}
    .dots-deco span:nth-child(6){background:var(--blush);animation-delay:.75s;}
    @keyframes dotPulse{0%,100%{transform:scale(1);opacity:.7}50%{transform:scale(1.4);opacity:1}}

    .page-body { padding: 16px 28px 22px; }
    .section-pill { display:inline-flex; align-items:center; gap:7px; background:linear-gradient(135deg,var(--petal),var(--blush)); color:var(--mauve); font-family:'Noto Naskh Arabic',serif; font-weight:700; font-size:.92rem; padding:5px 12px 5px 10px; border-radius:50px; margin-bottom:9px; border:1.5px solid var(--rose); box-shadow:0 3px 10px rgba(224,122,148,.14); width:100%; justify-content:flex-end; }
    .subsection-label { font-family:'Noto Naskh Arabic',serif; font-size:.88rem; font-weight:600; color:var(--deep-rose); margin:10px 0 5px; padding-right:10px; border-right:3px solid var(--rose); text-align:right; }
    .code-card { background:var(--code-bg); border:1.5px solid var(--code-border); border-radius:11px; padding:9px 13px; margin-bottom:7px; direction:ltr; text-align:left; position:relative; overflow:hidden; }
    .code-card::before { content:''; position:absolute; top:0; right:0; width:4px; height:100%; background:linear-gradient(180deg,var(--rose),var(--blush)); border-radius:0 11px 11px 0; }
    .code-card code { font-family:'Courier New',monospace; font-size:.78rem; color:var(--text-dark); line-height:1.9; display:block; white-space:pre-wrap; word-break:break-word; }
    .note-box { background:linear-gradient(135deg,var(--cream),var(--petal)); border:1px solid var(--blush); border-radius:9px; padding:7px 11px; margin:5px 0 3px; display:flex; align-items:flex-start; gap:7px; flex-direction:row-reverse; font-family:'Noto Naskh Arabic',serif; font-size:.83rem; color:var(--text-mid); text-align:right; }
    .note-star { font-size:.93rem; flex-shrink:0; }
    .tools-table { width:100%; border-collapse:separate; border-spacing:0 4px; text-align:right; font-family:'Noto Naskh Arabic',serif; }
    .tools-table td { padding:5px 11px; font-size:.81rem; }
    .tools-table tr:nth-child(odd)  td { background:var(--soft-pink); }
    .tools-table tr:nth-child(even) td { background:var(--petal); }
    .tools-table td:last-child { border-radius:7px 0 0 7px; font-weight:600; color:var(--mauve); white-space:nowrap; }
    .tools-table td:first-child { border-radius:0 7px 7px 0; color:var(--text-light); font-size:.76rem; }
    .abbr-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:5px; }
    .abbr-item { background:var(--soft-pink); border-radius:9px; padding:5px 9px; display:flex; align-items:center; gap:7px; border:1px solid var(--code-border); }
    .abbr-key { font-family:'Courier New',monospace; font-weight:bold; font-size:.77rem; color:var(--deep-rose); background:#fff; border-radius:5px; padding:2px 6px; border:1px solid var(--blush); flex-shrink:0; min-width:36px; text-align:center; }
    .abbr-val { font-family:'Lato',sans-serif; font-size:.71rem; color:var(--text-mid); direction:ltr; text-align:left; }
    .heart-divider { display:flex; align-items:center; gap:10px; padding:0 28px; }
    .heart-divider::before,.heart-divider::after { content:''; flex:1; height:1px; background:linear-gradient(90deg,transparent,var(--blush),transparent); }
    .heart-center { font-size:.92rem; color:var(--rose); }
    .page-footer { background:linear-gradient(135deg,var(--petal),var(--blush)); padding:8px 28px; display:flex; align-items:center; justify-content:space-between; }
    .footer-brand { font-family:'Playfair Display',serif; font-style:italic; font-size:.88rem; color:var(--mauve); }
    .footer-tagline { font-family:'Lato',sans-serif; font-size:.53rem; letter-spacing:3px; text-transform:uppercase; color:var(--deep-rose); }
    .footer-hearts { font-size:.78rem; letter-spacing:3px; }
    .footer-page-num { font-family:'Lato',serif; font-size:.78rem; color:var(--text-light); }
    .cover-image-wrap { position:relative; z-index:1; display:flex; justify-content:center; margin-top:12px; }
    .cover-image-wrap img { width:160px; height:160px; object-fit:cover; border-radius:50%; border:4px solid rgba(255,255,255,.7); box-shadow:0 8px 28px rgba(155,58,82,.28); }

    @media print {
      @page { size: A4 portrait; margin: 0; }

      /* ── Preserve every colour and background exactly as on-screen ── */
      *, *::before, *::after {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust:         exact !important;
        animation:  none !important;
        transition: none !important;
      }

      /* ── Hide all UI chrome ── */
      .pb-topbar, .saved-strip, .builder-panel,
      #toast, .preview-placeholder { display: none !important; }

      /* ── Flatten the shell so pages flow vertically ── */
      html, body {
        height: auto !important;
        overflow: visible !important;
        background: #fff !important;
      }
      .pb-shell {
        display: block !important;
        height: auto !important;
        overflow: visible !important;
      }
      .builder-area {
        display: block !important;
        height: auto !important;
        overflow: visible !important;
      }
      .preview-panel {
        display: block !important;
        height: auto !important;
        overflow: visible !important;
        padding: 0 !important;
        background: #fff !important;
      }
      #patternOutput { display: block !important; }

      /* ── One .page div = one printed A4 page ── */
      .page {
        width:      210mm !important;
        min-height: 297mm !important;
        max-height: 297mm !important;
        overflow:   hidden !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        margin: 0 !important;
        page-break-after:  always !important;
        break-after:       page !important;
        page-break-inside: avoid !important;
        break-inside:      avoid !important;
        display: flex !important;
        flex-direction: column !important;
      }
      .page:last-child {
        page-break-after: avoid !important;
        break-after:      avoid !important;
      }

      /* ── Make page body grow to fill remaining space ── */
      .page-body { flex: 1 !important; }

      /* ── Arabic text: lock direction and font ── */
      .pattern-title-ar, .pattern-subtitle-ar,
      .section-pill, .subsection-label,
      .note-box, .b-label,
      .tools-table td, .abbr-val,
      .footer-brand, .footer-tagline,
      .brand-tagline {
        font-family: 'Noto Naskh Arabic', 'Cairo', serif !important;
        direction: rtl !important;
      }

      /* ── Code stays LTR ── */
      .code-card, .code-card code, .abbr-key {
        direction: ltr !important;
        text-align: left !important;
        font-family: 'Courier New', monospace !important;
      }

      /* ── Brand names keep Playfair ── */
      .brand-name, .footer-brand { font-family: 'Playfair Display', serif !important; }
    }
  </style>
</head>
<body>
<div class="pb-shell">

  <!-- Top bar -->
  <div class="pb-topbar">
    <a class="pb-topbar-brand" href="/">croshim</a>
    <span class="pb-topbar-title"><i class="fas fa-magic" style="margin-left:.3rem;"></i> Pattern Builder</span>
    <a class="pb-topbar-back" href="/dashboard">
      <i class="fas fa-arrow-left"></i> لوحتي
    </a>
  </div>

  <!-- Saved strip -->
  <div class="saved-strip">
    <span class="saved-strip-label"><i class="fas fa-bookmark"></i> محفوظ:</span>
    <div class="saved-chips" id="savedChips">
      <% if (savedPatterns.length === 0) { %>
        <span class="saved-empty" id="emptyHint">لا يوجد باترنات محفوظة بعد</span>
      <% } %>
      <% savedPatterns.forEach(function(p) { %>
        <span class="saved-chip" id="chip-<%= p.id %>" data-pid="<%= p.id %>">
          <%= p.emoji || '🧶' %> <%= p.name %>
          <a class="chip-share" href="/pattern/<%= p.id %>"
            target="_blank" onclick="event.stopPropagation()" title="الصفحة العامة">
            <i class="fas fa-external-link-alt"></i>
          </a>
          <span class="chip-del" data-pid="<%= p.id %>" title="حذف">✕</span>
        </span>
      <% }); %>
    </div>
    <div class="strip-actions">
      <button onclick="savePattern()" class="btn-strip btn-strip-save" id="saveBtn">
        <i class="fas fa-save"></i> حفظ
      </button>
      <button onclick="newPattern()" class="btn-strip btn-strip-new">
        <i class="fas fa-plus"></i> جديد
      </button>
      <button onclick="saveToProduct()" class="btn-strip btn-strip-dash" id="saveDashBtn" style="display:none;">
        <i class="fas fa-layer-group"></i> حفظ في لوحتي
      </button>
      <button onclick="printPattern()" class="btn-strip btn-strip-print" id="printBtn" style="display:none;">
        <i class="fas fa-print"></i> طباعة / PDF
      </button>
    </div>
  </div>

  <!-- Builder area -->
  <div class="builder-area">

    <!-- Builder Panel -->
    <div class="builder-panel">
      <div class="builder-logo">croshim</div>
      <div class="builder-sub">pattern builder 🧶</div>
      <div class="builder-divider"></div>

      <input type="hidden" id="activePatternId" value="">

      <div class="b-section">
        <div class="b-section-title">🪡 Pattern Info</div>
        <label class="b-label">اسم الدمية / المنتج</label>
        <input type="text" class="b-input" id="patternName" placeholder="مثال: دُمية الدب اللطيف 🐻">
        <label class="b-label">وصف قصير (اختياري)</label>
        <input type="text" class="b-input" id="patternSubtitle" placeholder="مثال: باترن كروشيه متكامل 🐻🌿">
        <label class="b-label">إيموجي الغلاف</label>
        <input type="text" class="b-input" id="coverEmoji" placeholder="🐻" value="🧸" style="max-width:75px;text-align:center;">
        <label class="b-label">لون الباترن</label>
        <div class="theme-swatches" id="themeSwatches">
          <button class="theme-swatch active" data-theme="rose"     style="background:#E8839A;" onclick="applyTheme('rose')"     title="وردي"></button>
          <button class="theme-swatch"        data-theme="lavender" style="background:#B08CD5;" onclick="applyTheme('lavender')" title="بنفسجي"></button>
          <button class="theme-swatch"        data-theme="sage"     style="background:#7AB876;" onclick="applyTheme('sage')"     title="أخضر"></button>
          <button class="theme-swatch"        data-theme="ocean"    style="background:#6AA8D8;" onclick="applyTheme('ocean')"    title="أزرق"></button>
          <button class="theme-swatch"        data-theme="gold"     style="background:#D4A840;" onclick="applyTheme('gold')"     title="ذهبي"></button>
          <button class="theme-swatch"        data-theme="peach"    style="background:#E0916A;" onclick="applyTheme('peach')"    title="خوخي"></button>
        </div>
        <label class="b-label">صورة المنتج (اختياري)</label>
        <div class="img-upload-zone" id="uploadZone">
          <input type="file" accept="image/*" onchange="handleImageUpload(event)">
          <div class="img-upload-label">
            <span>🖼️</span>اضغطي لرفع صورة الدمية
          </div>
          <img class="img-preview-thumb" id="imgThumb" src="" alt="preview">
        </div>
        <button class="btn-remove-img" id="removeImgBtn" onclick="removeImage()">✕ حذف الصورة</button>
      </div>

      <div class="b-section">
        <div class="b-section-title">🧶 الأدوات</div>
        <div id="toolsList"></div>
        <button class="btn-add-part" onclick="addTool()">+ إضافة أداة</button>
      </div>

      <div class="b-section">
        <div class="b-section-title">📋 Abbreviations</div>
        <small style="color:var(--text-light);font-size:.71rem;display:block;margin-bottom:5px;text-align:right;">
          الاختصارات الافتراضية مضافة تلقائياً — أضف المخصصة هنا فقط
        </small>
        <div id="abbrList"></div>
        <button class="btn-add-part" onclick="addAbbr()">+ إضافة اختصار مخصص</button>
      </div>

      <div class="b-section">
        <div class="b-section-title">✂️ أجزاء الباترن</div>
        <small style="color:var(--text-light);font-size:.71rem;display:block;margin-bottom:5px;text-align:right;">
          كل جزء (الرأس، الجسم، الأيدي...) يصبح قسماً منفصلاً
        </small>
        <div id="partsList"></div>
        <button class="btn-add-part" onclick="addPart()">+ إضافة جزء جديد</button>
      </div>

      <button class="btn-generate" onclick="generatePattern()">✨ &nbsp; Generate Pattern</button>
    </div>

    <!-- Preview Panel -->
    <div class="preview-panel" id="previewPanel">
      <div class="preview-placeholder" id="placeholder">
        <div class="ph-icon">🧶</div>
        <p>املئي البيانات على اليسار<br>ثم اضغطي <strong>Generate Pattern</strong></p>
      </div>
      <div id="patternOutput"></div>
    </div>

  </div>
</div>

<div id="toast"></div>

<script>
const CSRF_TOKEN = '<%= csrfToken %>';

const THEMES = {
  rose:     { blush:'#F4C2C2', rose:'#E8839A', deepRose:'#C0516B', mauve:'#9B3A52', softPink:'#FAE4EA', petal:'#F9D4DC', cream:'#FDF0F3', textDark:'#5A2A38', textMid:'#8B4D60', textLight:'#B8798A', codeBg:'#FDF5F7', codeBorder:'#EEC5CF', grad:'linear-gradient(135deg,#F9D4DC 0%,#F0A8B8 40%,#E07A94 100%)' },
  lavender: { blush:'#D8C5F0', rose:'#B08CD5', deepRose:'#7B52BB', mauve:'#5B3A9B', softPink:'#EDE4F8', petal:'#E2D4F5', cream:'#F5F0FD', textDark:'#2D1A5A', textMid:'#5A3A8A', textLight:'#907AB8', codeBg:'#F5F0FD', codeBorder:'#CDB8E8', grad:'linear-gradient(135deg,#E2D4F5 0%,#C8A8E8 40%,#A87AD4 100%)' },
  sage:     { blush:'#C2D9C0', rose:'#7AB876', deepRose:'#4A8A46', mauve:'#2D6A2A', softPink:'#E4F0E2', petal:'#D4EDD2', cream:'#F0F8EF', textDark:'#1A3819', textMid:'#3A5A38', textLight:'#6A8A68', codeBg:'#F0F8EF', codeBorder:'#B8D8B6', grad:'linear-gradient(135deg,#D4EDD2 0%,#A8D8A4 40%,#7AB876 100%)' },
  ocean:    { blush:'#C0D8F0', rose:'#6AA8D8', deepRose:'#3A7AB8', mauve:'#1A4A8A', softPink:'#E0EEF8', petal:'#D0E8F5', cream:'#F0F5FD', textDark:'#0A2448', textMid:'#2A4A78', textLight:'#6A8AB0', codeBg:'#F0F5FD', codeBorder:'#B0D0E8', grad:'linear-gradient(135deg,#D0E8F5 0%,#A0C8E8 40%,#6AAAD0 100%)' },
  gold:     { blush:'#F0DCA8', rose:'#D4A840', deepRose:'#B07820', mauve:'#7A5010', softPink:'#F8EDD0', petal:'#F5E4C0', cream:'#FDF8ED', textDark:'#3A2808', textMid:'#6A4820', textLight:'#9A7848', codeBg:'#FDF8ED', codeBorder:'#E8CFA0', grad:'linear-gradient(135deg,#F5E4C0 0%,#E8C880 40%,#D4A840 100%)' },
  peach:    { blush:'#F0C8B0', rose:'#E0916A', deepRose:'#C06040', mauve:'#9A3820', softPink:'#F8E4D4', petal:'#F5D4C0', cream:'#FDF5F0', textDark:'#481808', textMid:'#7A3820', textLight:'#B07858', codeBg:'#FDF5F0', codeBorder:'#E8C0A8', grad:'linear-gradient(135deg,#F5D4C0 0%,#E8B090 40%,#D88060 100%)' },
};

window._colorTheme = 'rose';

function applyTheme(key) {
  const t = THEMES[key] || THEMES.rose;
  window._colorTheme = key;
  const area = document.querySelector('.builder-area');
  if (area) {
    area.style.setProperty('--blush',       t.blush);
    area.style.setProperty('--rose',        t.rose);
    area.style.setProperty('--deep-rose',   t.deepRose);
    area.style.setProperty('--mauve',       t.mauve);
    area.style.setProperty('--soft-pink',   t.softPink);
    area.style.setProperty('--petal',       t.petal);
    area.style.setProperty('--cream',       t.cream);
    area.style.setProperty('--text-dark',   t.textDark);
    area.style.setProperty('--text-mid',    t.textMid);
    area.style.setProperty('--text-light',  t.textLight);
    area.style.setProperty('--code-bg',     t.codeBg);
    area.style.setProperty('--code-border', t.codeBorder);
    area.style.setProperty('--cover-grad',  t.grad);
  }
  document.querySelectorAll('.theme-swatch').forEach(s => s.classList.remove('active'));
  const sw = document.querySelector(`.theme-swatch[data-theme="${key}"]`);
  if (sw) sw.classList.add('active');
}

const DEFAULT_ABBR = [
  {key:'MR',  val:'magic ring / magic loop'},
  {key:'Ch',  val:'chain'},
  {key:'sc',  val:'single crochet'},
  {key:'inc', val:'increase (2 sc in 1 stitch)'},
  {key:'inc+',val:'3 sc in 1 stitch'},
  {key:'dec', val:'decrease (sc 2 together)'},
  {key:'ss',  val:'slip stitch'},
  {key:'f/o', val:'fasten off'},
];

let tools = [], abbrs = [], parts = [];

function init() {
  addTool('١- خيط قطن لون', 'سكري • وردي • برتقالي • أخضر');
  addTool('٢- إبرة كروشيه', 'مناسبة للخيط');
  addTool('٣- عيون دمى', '');
  addTool('٤- زر مع إبرة وخيط', '');
  addTool('٥- مقص وإبرة تثبيت', '');
  addTool('٦- فايبر للحشو', '');
  addPart('🐻 الرأس', 'R1: mr 6sc\nR2: inc X 6 = 12sc\nR3: (sc, inc) X 6 = 18sc\n...', 'نحشي بالفايبر قبل الإغلاق');
}

/* ── Tools ── */
function addTool(name='', detail='') {
  const id = Date.now() + Math.random();
  tools.push({id, name, detail});
  renderTools();
}
function removeTool(id) { tools = tools.filter(t => t.id !== id); renderTools(); }
function renderTools() {
  document.getElementById('toolsList').innerHTML = tools.map(t => `
    <div class="part-block" style="padding:8px 10px;">
      <div class="part-block-head">
        <button class="btn-remove" onclick="removeTool(${t.id})">✕</button>
        <input class="b-input part-name-input" type="text"
          placeholder="اسم الأداة" value="${esc(t.name)}"
          onchange="updateTool(${t.id},'name',this.value)">
      </div>
      <input type="text" class="b-input" style="margin-bottom:0!important;" placeholder="تفاصيل (اختياري)"
        value="${esc(t.detail)}" onchange="updateTool(${t.id},'detail',this.value)">
    </div>`).join('');
}
function updateTool(id, field, val) { const t = tools.find(x => x.id === id); if (t) t[field] = val; }

/* ── Abbreviations ── */
function addAbbr(key='', val='') {
  const id = Date.now() + Math.random();
  abbrs.push({id, key, val});
  renderAbbrs();
}
function removeAbbr(id) { abbrs = abbrs.filter(a => a.id !== id); renderAbbrs(); }
function renderAbbrs() {
  document.getElementById('abbrList').innerHTML = abbrs.map(a => `
    <div class="part-block" style="padding:8px 10px;">
      <div class="b-row2">
        <input type="text" class="b-input" style="margin-bottom:0!important;direction:ltr;text-align:left;"
          placeholder="e.g. BLO" value="${esc(a.key)}" onchange="updateAbbr(${a.id},'key',this.value)">
        <input type="text" class="b-input" style="margin-bottom:0!important;direction:ltr;text-align:left;"
          placeholder="back loop only" value="${esc(a.val)}" onchange="updateAbbr(${a.id},'val',this.value)">
      </div>
      <button class="btn-remove" onclick="removeAbbr(${a.id})" style="margin-top:4px;">✕ حذف</button>
    </div>`).join('');
}
function updateAbbr(id, field, val) { const a = abbrs.find(x => x.id === id); if (a) a[field] = val; }

/* ── Parts ── */
function addPart(name='', code='', note='', imgs=[]) {
  const id = Date.now() + Math.random();
  parts.push({id, name, code, note, imgs: imgs || []});
  renderParts();
}
function removePart(id) { parts = parts.filter(p => p.id !== id); renderParts(); }
function renderParts() {
  document.getElementById('partsList').innerHTML = parts.map(p => `
    <div class="part-block">
      <div class="part-block-head">
        <button class="btn-remove" onclick="removePart(${p.id})">✕</button>
        <input class="b-input part-name-input" type="text"
          placeholder="اسم الجزء (مثال: 🐻 الرأس)"
          value="${esc(p.name)}" onchange="updatePart(${p.id},'name',this.value)">
      </div>
      <label class="b-label">كود الباترن (Rows)</label>
      <textarea class="b-textarea" placeholder="R1: mr 6sc&#10;R2: inc X 6 = 12sc&#10;..."
        onchange="updatePart(${p.id},'code',this.value)">${esc(p.code)}</textarea>
      <label class="b-label">ملاحظة (اختياري)</label>
      <textarea class="b-textarea part-note-input" style="min-height:34px!important;"
        placeholder="مثال: نحشي بالفايبر قبل الإغلاق"
        onchange="updatePart(${p.id},'note',this.value)">${esc(p.note)}</textarea>
      <label class="b-label" style="margin-top:5px;">صور مرجعية (اختياري)</label>
      <div class="part-imgs-grid" id="partImgsGrid-${p.id}">
        ${(p.imgs||[]).map((src,idx)=>`
          <div class="part-thumb-wrap">
            <img src="${src}">
            <button class="part-thumb-del" onclick="removePartImage(${p.id},${idx})">✕</button>
          </div>`).join('')}
      </div>
      <div class="part-img-zone" id="partImgZone-${p.id}">
        <input type="file" accept="image/*" multiple onchange="handlePartImageUpload(${p.id}, event)">
        <div class="part-img-zone-label">📷 إضافة صور (يمكن تحديد أكثر من صورة)</div>
      </div>
    </div>`).join('');
}
function updatePart(id, field, val) { const p = parts.find(x => x.id === id); if (p) p[field] = val; }

/* ── Generate ── */
function generatePattern() {
  syncAll();
  const name     = document.getElementById('patternName').value.trim()     || 'باترن كروشيه';
  const subtitle = document.getElementById('patternSubtitle').value.trim() || 'باترن كروشيه متكامل';
  const emoji    = document.getElementById('coverEmoji').value.trim()      || '🧶';
  const coverImg = window._coverImageData || null;
  const allAbbrs = [...DEFAULT_ABBR, ...abbrs.filter(a => a.key)];
  const hasCover = !!coverImg;
  const PARTS_PER_PAGE = 4;
  const totalPages = Math.ceil(parts.length / PARTS_PER_PAGE) + (hasCover ? 2 : 1);

  let html = '';

  if (hasCover) {
    html += `
    <div class="page" style="min-height:500px;display:flex;flex-direction:column;">
      <div class="cover-header" style="flex:1;padding:40px 32px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:0;">
        <div style="position:relative;z-index:1;text-align:center;width:100%;">
          <div class="brand-name" style="font-size:1.75rem;margin-bottom:2px;">croshim</div>
          <div class="brand-tagline" style="margin-bottom:22px;">crochet with heart</div>
        </div>
        <div style="position:relative;z-index:1;display:flex;justify-content:center;margin-bottom:22px;">
          <img src="${coverImg}" alt="product"
            style="width:220px;height:220px;object-fit:cover;border-radius:50%;
                   border:5px solid rgba(255,255,255,.8);box-shadow:0 10px 40px rgba(155,58,82,.3);">
        </div>
        <div style="position:relative;z-index:1;text-align:center;">
          <div class="pattern-title-ar" style="font-size:1.75rem;">${name}</div>
          <div class="pattern-subtitle-ar" style="margin-top:4px;">${subtitle}</div>
        </div>
      </div>
      <div class="dots-deco"><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <div class="heart-divider" style="margin:0 28px;"><span class="heart-center">🤍</span></div>
      <div class="page-footer">
        <div><div class="footer-brand">croshim</div><div class="footer-tagline">crochet with heart</div></div>
        <div class="footer-hearts">🤍 🤍 🤍</div>
        <div class="footer-page-num">١ / ${totalPages}</div>
      </div>
    </div>`;
  }

  const toolsPage = hasCover ? 2 : 1;
  html += `
  <div class="page">
    <div class="cover-header">
      <div class="brand-row">
        <div><div class="brand-name">croshim</div><div class="brand-tagline">crochet with heart</div></div>
        <div class="yarn-icon">${emoji}</div>
      </div>
      <div class="pattern-title-ar">${name}</div>
      <div class="pattern-subtitle-ar">${subtitle}</div>
    </div>
    <div class="dots-deco"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="page-body">
      <div class="section-pill"><span>🧶</span> الأدوات المطلوبة</div>
      <table class="tools-table">
        ${tools.filter(t=>t.name).map(t=>`<tr><td>${t.detail}</td><td>${t.name}</td></tr>`).join('')}
      </table>
      <div style="height:14px"></div>
      <div class="section-pill"><span>📋</span> الرموز والاختصارات</div>
      <div class="abbr-grid">
        ${allAbbrs.map(a=>`<div class="abbr-item"><span class="abbr-key">${a.key}</span><span class="abbr-val">${a.val}</span></div>`).join('')}
      </div>
    </div>
    <div class="heart-divider"><span class="heart-center">🤍</span></div>
    <div class="page-footer">
      <div><div class="footer-brand">croshim</div><div class="footer-tagline">crochet with heart</div></div>
      <div class="footer-hearts">🤍 🤍 🤍</div>
      <div class="footer-page-num">${toolsPage} / ${totalPages}</div>
    </div>
  </div>`;

  chunkArray(parts, PARTS_PER_PAGE).forEach((chunk, ci) => {
    const pageNum = ci + (hasCover ? 3 : 2);
    html += `
    <div class="page">
      <div class="cover-header" style="padding:16px 28px;">
        <div class="brand-row" style="margin-bottom:0;">
          <div class="brand-name" style="font-size:1.15rem;">croshim</div>
          <div style="text-align:center;flex:1;">
            <div class="pattern-title-ar" style="font-size:1.25rem;">${emoji} ${name}</div>
          </div>
          <div class="yarn-icon" style="font-size:1.55rem;">🧶</div>
        </div>
      </div>
      <div class="dots-deco"><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <div class="page-body">
        ${chunk.map(p => {
          const imgs = p.imgs && p.imgs.length ? p.imgs : (p.img ? [p.img] : []);
          return `
          <div class="subsection-label">${p.name}</div>
          ${imgs.length ? `<div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;margin-bottom:8px;">${imgs.map(src=>`<img src="${src}" style="height:140px;max-width:190px;object-fit:cover;border-radius:9px;border:2px solid var(--blush);">`).join('')}</div>` : ''}
          <div class="code-card"><code>${escHtml(p.code)}</code></div>
          ${p.note ? `<div class="note-box"><span class="note-star">⭐</span>${p.note}</div>` : ''}`;
        }).join('')}
      </div>
      <div class="heart-divider"><span class="heart-center">🤍</span></div>
      <div class="page-footer">
        <div><div class="footer-brand">croshim</div><div class="footer-tagline">crochet with heart</div></div>
        <div class="footer-hearts">🤍 🤍 🤍</div>
        <div class="footer-page-num">${pageNum} / ${totalPages}</div>
      </div>
    </div>`;
  });

  document.getElementById('placeholder').style.display = 'none';
  document.getElementById('patternOutput').innerHTML = html;
  document.getElementById('saveDashBtn').style.display = 'inline-flex';
  document.getElementById('printBtn').style.display = 'inline-flex';
  document.getElementById('previewPanel').scrollTo({top:0, behavior:'smooth'});
}

/* ── Save / Load / Delete ── */
async function savePattern() {
  syncAll();
  const btn = document.getElementById('saveBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

  const data = {
    id:          document.getElementById('activePatternId').value || null,
    name:        document.getElementById('patternName').value.trim()    || 'باترن جديد',
    subtitle:    document.getElementById('patternSubtitle').value.trim(),
    emoji:       document.getElementById('coverEmoji').value.trim()     || '🧶',
    cover_image:  window._coverImageData || null,
    tools:        JSON.stringify(tools),
    abbrs:        JSON.stringify(abbrs),
    parts:        JSON.stringify(parts),
    color_theme:  window._colorTheme || 'rose',
  };

  try {
    const res  = await fetch('/pattern-builder/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
      body: JSON.stringify(data),
    });
    const json = await res.json();
    if (json.success) {
      document.getElementById('activePatternId').value = json.pattern.id;
      upsertChip(json.pattern);
      showToast('تم الحفظ بنجاح ✓');
    } else {
      showToast('خطأ في الحفظ: ' + (json.error || ''));
    }
  } catch (e) {
    showToast('خطأ في الاتصال');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-save"></i> حفظ';
  }
}

async function loadPattern(id) {
  try {
    const res  = await fetch(`/pattern-builder/load/${id}`);
    const data = await res.json();
    if (data.error) { showToast('الباترن غير موجود'); return; }

    document.getElementById('activePatternId').value  = id;
    document.getElementById('patternName').value      = data.name     || '';
    document.getElementById('patternSubtitle').value  = data.subtitle || '';
    document.getElementById('coverEmoji').value       = data.emoji    || '🧶';
    applyTheme(data.color_theme || 'rose');

    if (data.cover_image) {
      window._coverImageData = data.cover_image;
      const thumb = document.getElementById('imgThumb');
      thumb.src = data.cover_image; thumb.style.display = 'block';
      document.getElementById('removeImgBtn').style.display = 'block';
    } else {
      window._coverImageData = null;
      document.getElementById('imgThumb').style.display = 'none';
      document.getElementById('removeImgBtn').style.display = 'none';
    }

    tools = JSON.parse(data.tools || '[]');
    abbrs = JSON.parse(data.abbrs || '[]');
    parts = JSON.parse(data.parts || '[]').map(p => ({
      ...p,
      imgs: p.imgs || (p.img ? [p.img] : []),
    }));
    renderTools(); renderAbbrs(); renderParts();

    document.querySelectorAll('.saved-chip').forEach(c => c.classList.remove('active-chip'));
    const chip = document.getElementById('chip-' + id);
    if (chip) chip.classList.add('active-chip');
    showToast(`تم تحميل "${data.name}" ✓`);
  } catch (e) {
    showToast('خطأ في التحميل');
  }
}

async function deletePattern(id) {
  if (!confirm('حذف هذا الباترن نهائياً؟')) return;
  try {
    const res  = await fetch(`/pattern-builder/delete/${id}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
    });
    const json = await res.json();
    if (json.success) {
      const chip = document.getElementById('chip-' + id);
      if (chip) chip.remove();
      if (document.getElementById('activePatternId').value == id)
        document.getElementById('activePatternId').value = '';
      if (!document.querySelectorAll('.saved-chip').length) {
        const hint = document.createElement('span');
        hint.className = 'saved-empty'; hint.id = 'emptyHint';
        hint.textContent = 'لا يوجد باترنات محفوظة بعد';
        document.getElementById('savedChips').prepend(hint);
      }
      showToast('تم الحذف ✓');
    }
  } catch (e) {
    showToast('خطأ في الحذف');
  }
}

function newPattern() {
  document.getElementById('activePatternId').value = '';
  document.getElementById('patternName').value     = '';
  document.getElementById('patternSubtitle').value = '';
  document.getElementById('coverEmoji').value      = '🧶';
  applyTheme('rose');
  removeImage();
  tools = []; abbrs = []; parts = [];
  renderTools(); renderAbbrs(); renderParts();
  document.getElementById('placeholder').style.display = '';
  document.getElementById('patternOutput').innerHTML = '';
  document.getElementById('saveDashBtn').style.display = 'none';
  document.getElementById('printBtn').style.display = 'none';
  document.querySelectorAll('.saved-chip').forEach(c => c.classList.remove('active-chip'));
  init();
}

/* ── Chip helpers ── */
function upsertChip(pattern) {
  const hint = document.getElementById('emptyHint');
  if (hint) hint.remove();
  let chip = document.getElementById('chip-' + pattern.id);
  if (!chip) {
    chip = document.createElement('span');
    chip.className = 'saved-chip';
    chip.id = 'chip-' + pattern.id;
    document.getElementById('savedChips').prepend(chip);
  }
  chip.dataset.pid = pattern.id;
  chip.innerHTML = `${pattern.emoji || '🧶'} ${pattern.name}
    <a class="chip-share" href="/pattern/${pattern.id}"
      target="_blank" onclick="event.stopPropagation()" title="الصفحة العامة">
      <i class="fas fa-external-link-alt"></i>
    </a>
    <span class="chip-del" data-pid="${pattern.id}" title="حذف">✕</span>`;
  document.querySelectorAll('.saved-chip').forEach(c => c.classList.remove('active-chip'));
  chip.classList.add('active-chip');
}

/* ── Image upload ── */
function handleImageUpload(e) {
  const file = e.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = function(ev) {
    window._coverImageData = ev.target.result;
    const thumb = document.getElementById('imgThumb');
    thumb.src = ev.target.result; thumb.style.display = 'block';
    document.getElementById('removeImgBtn').style.display = 'block';
    document.getElementById('uploadZone').style.borderColor = 'var(--deep-rose)';
  };
  reader.readAsDataURL(file);
}
function removeImage() {
  window._coverImageData = null;
  const thumb = document.getElementById('imgThumb');
  thumb.src = ''; thumb.style.display = 'none';
  document.getElementById('removeImgBtn').style.display = 'none';
  document.getElementById('uploadZone').style.borderColor = 'var(--rose)';
}

/* ── Per-part image upload ── */
function handlePartImageUpload(id, e) {
  const files = Array.from(e.target.files);
  if (!files.length) return;
  const part = parts.find(p => p.id === id);
  if (!part) return;
  if (!part.imgs) part.imgs = [];
  let loaded = 0;
  files.forEach(file => {
    const reader = new FileReader();
    reader.onload = function(ev) {
      part.imgs.push(ev.target.result);
      loaded++;
      if (loaded === files.length) renderParts();
    };
    reader.readAsDataURL(file);
  });
}
function removePartImage(id, idx) {
  const part = parts.find(p => p.id === id);
  if (part && part.imgs) { part.imgs.splice(idx, 1); renderParts(); }
}


/* ── Toast ── */
let toastTimer;
function showToast(msg, isHtml = false) {
  const t = document.getElementById('toast');
  if (isHtml) t.innerHTML = msg; else t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 3500);
}

/* ── Helpers ── */
function syncAll() {
  document.querySelectorAll('#toolsList .part-block').forEach((el, i) => {
    if (tools[i]) { tools[i].name = el.querySelectorAll('input')[0].value; tools[i].detail = el.querySelectorAll('input')[1]?.value || ''; }
  });
  document.querySelectorAll('#partsList .part-block').forEach((el, i) => {
    if (parts[i]) { parts[i].name = el.querySelectorAll('input')[0].value; parts[i].code = el.querySelectorAll('textarea')[0].value; parts[i].note = el.querySelectorAll('textarea')[1].value; }
  });
  document.querySelectorAll('#abbrList .part-block').forEach((el, i) => {
    if (abbrs[i]) { abbrs[i].key = el.querySelectorAll('input')[0].value; abbrs[i].val = el.querySelectorAll('input')[1].value; }
  });
}
function chunkArray(arr, size) {
  const res = [];
  for (let i = 0; i < arr.length; i += size) res.push(arr.slice(i, i + size));
  return res;
}
function esc(str) { return (str||'').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escHtml(str) { return (str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }


/* ── Save to dashboard (dedup handled server-side) ── */
async function saveToProduct() {
  await savePattern();
  const patternId = document.getElementById('activePatternId').value;
  if (!patternId) { showToast('احفظي الباترن أولاً'); return; }

  const btn = document.getElementById('saveDashBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

  const name = document.getElementById('patternName').value.trim() || 'باترن كروشيه';
  const desc = document.getElementById('patternSubtitle').value.trim();

  try {
    const res  = await fetch('/pattern-builder/save-as-product', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
      body:    JSON.stringify({ name, description: desc, patternId }),
    });
    const json = await res.json();
    if (json.success) {
      showToast('تمت الإضافة للوحتي ✓ — <a href="/dashboard">عرض</a>', true);
    } else {
      showToast('خطأ: ' + (json.error || ''));
    }
  } catch (e) {
    showToast('خطأ: ' + e.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-layer-group"></i> حفظ في لوحتي';
  }
}

/* ── Print only ── */
function printPattern() {
  generatePattern();
  document.fonts.ready.then(() => window.print());
}

init();

document.getElementById('savedChips').addEventListener('click', function(e) {
  const del = e.target.closest('.chip-del');
  if (del) { e.stopPropagation(); deletePattern(del.dataset.pid); return; }
  const chip = e.target.closest('.saved-chip');
  if (chip && chip.dataset.pid) loadPattern(chip.dataset.pid);
});

(function () {
  const loadId = new URLSearchParams(window.location.search).get('load');
  if (loadId) { loadPattern(Number(loadId)); history.replaceState({}, '', window.location.pathname); }
})();
</script>

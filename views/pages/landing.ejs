<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">

<%- include("../layouts/head", {
  pageTitle: t.seo_home_title,
  seo: {
    title: t.seo_home_title,
    description: t.seo_home_desc,
    jsonLd: {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": siteUrl + "/#organization",
          "name": t.seo_site_name,
          "url": siteUrl,
          "logo": siteUrl + "/favicon.svg",
          "image": siteUrl + "/images/photo_cro.webp",
          "description": t.seo_home_desc,
          "email": "admin@croshim-studio.com",
          "sameAs": ["https://croshim.com/"]
        },
        {
          "@type": "WebSite",
          "@id": siteUrl + "/#website",
          "url": siteUrl,
          "name": t.seo_site_name,
          "description": t.seo_home_desc,
          "inLanguage": lang === "en" ? "en" : "ar",
          "publisher": { "@id": siteUrl + "/#organization" }
        }
      ]
    }
  }
}) %>

<body>

  <section id="title" class="hero">

    <%- include("../partials/navbar") %>

    <!-- Floating hearts -->
    <span class="hero-float hero-float-1">♥</span>
    <span class="hero-float hero-float-2">♥</span>
    <span class="hero-float hero-float-3">♥</span>

    <div class="container hero-container">

      <%- include("../partials/alerts", { error_message, success_message }) %>

      <div class="row hero-row align-items-center" data-aos="fade-up">

        <!-- ILLUSTRATION (hidden on mobile) -->
        <div class="col-lg-5 d-none d-lg-flex justify-content-center hero-art-col">
          <div class="hero-workbook-preview" dir="rtl" aria-label="<%= lang === 'en' ? 'Crochet pattern workbook preview' : 'معاينة باني باترون الكروشيه' %>">
            <aside class="hero-workbook-sidebar">
              <h3><i class="fas fa-magic"></i> <%= lang === 'en' ? 'Pattern details' : 'معلومات الباترون' %></h3>
              <label><%= lang === 'en' ? 'Pattern name' : 'اسم الباترون' %></label><div><%= lang === 'en' ? 'Bellflower charm' : 'ميدالية زهرة الأجراس' %></div>
              <label><%= lang === 'en' ? 'Skill level' : 'مستوى الصعوبة' %></label><div><%= lang === 'en' ? 'Beginner' : 'مبتدئة' %>⌄</div>
              <label><%= lang === 'en' ? 'Materials' : 'الأدوات والخامات' %></label><p><span><%= lang === 'en' ? 'Cotton yarn' : 'خيط قطني' %></span><span><%= lang === 'en' ? 'Hook 2.5 mm' : 'إبرة 2.5 مم' %></span></p>
              <hr><h3><i class="fas fa-cut"></i> <%= lang === 'en' ? 'Pattern parts' : 'أجزاء الباترون' %></h3>
              <ul><li>R1 <span><%= lang === 'en' ? 'Magic ring, 6 sc' : 'حلقة سحرية، 6 غرز' %></span></li><li>R2 <span><%= lang === 'en' ? 'Increase x 6' : 'زيادة × 6' %></span></li><li>R3 <span><%= lang === 'en' ? 'Repeat stitches' : 'تكرار الغرز' %></span></li></ul>
              <b><i class="fas fa-file-pdf"></i> <%= lang === 'en' ? 'Preview PDF' : 'معاينة الباترون PDF' %></b>
            </aside>
            <div class="hero-workbook-cover">
              <em>croshim<small>CROCHET WITH HEART</small></em>
              <span class="hero-workbook-photo">🧶</span>
              <h3><%= lang === 'en' ? 'Bellflower Charm' : 'ميدالية زهرة الأجراس' %></h3>
              <p><%= lang === 'en' ? 'A cheerful crochet pattern' : 'باترون كروشيه لطيف' %></p>
              <i>● ● <strong>●</strong> ● ●</i>
              <footer><span>1 / 3</span><span>♥ ♥ ♥</span><em>croshim</em></footer>
            </div>
          </div>
          <div class="yarn-art">
            <svg viewBox="0 0 320 310" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="185" cy="155" r="130" fill="rgba(232,160,176,.18)"/>
              <circle cx="88" cy="210" r="62" fill="#e8a0b0"/>
              <ellipse cx="88" cy="210" rx="62" ry="24" fill="none" stroke="white" stroke-width="2" opacity="0.45" transform="rotate(-28 88 210)"/>
              <ellipse cx="88" cy="210" rx="62" ry="24" fill="none" stroke="white" stroke-width="2" opacity="0.45" transform="rotate(28 88 210)"/>
              <ellipse cx="88" cy="210" rx="24" ry="62" fill="none" stroke="white" stroke-width="2" opacity="0.45"/>
              <circle cx="88" cy="210" r="62" fill="none" stroke="#c4637a" stroke-width="1" opacity="0.25"/>
              <path d="M 135 168 C 158 138 180 115 205 95 C 218 85 228 70 234 52" stroke="#e8a0b0" stroke-width="5.5" stroke-linecap="round"/>
              <path d="M 168 135 C 168 114 190 103 206 120 C 222 103 244 114 244 135 C 244 156 206 182 206 182 C 206 182 168 156 168 135 Z"
                    fill="none" stroke="#c4637a" stroke-width="4" stroke-linejoin="round"/>
              <rect x="252" y="18" width="11" height="85" rx="5.5" fill="#ddb8c0"/>
              <rect x="254" y="18" width="3" height="85" rx="1.5" fill="rgba(255,255,255,0.4)"/>
              <path d="M257 103 C257 122 247 130 238 125 C229 120 231 110 240 109"
                    stroke="#cfa8b2" stroke-width="9" fill="none" stroke-linecap="round"/>
              <path d="M257 103 C257 116 251 124 244 122"
                    stroke="rgba(255,255,255,0.35)" stroke-width="3" fill="none" stroke-linecap="round"/>
              <path d="M 58 118 C 46 96 26 92 22 106 C 18 118 38 126 58 118 Z" fill="#e8a0b0" opacity="0.75"/>
              <path d="M 26 108 L 52 116" stroke="#c4637a" stroke-width="1.5" opacity="0.55" stroke-linecap="round"/>
              <path d="M 46 98 C 38 80 20 78 16 88 C 12 98 30 106 46 98 Z" fill="#e8a0b0" opacity="0.55"/>
              <path d="M 20 90 L 42 97" stroke="#c4637a" stroke-width="1.2" opacity="0.5" stroke-linecap="round"/>
              <circle cx="13" cy="83" r="4.5" fill="#c4637a" opacity="0.5"/>
              <circle cx="8"  cy="75" r="3.5" fill="#c4637a" opacity="0.4"/>
              <circle cx="16" cy="70" r="3"   fill="#c4637a" opacity="0.35"/>
              <path d="M 234 170 C 246 188 240 202 228 197 C 216 192 218 180 228 178"
                    stroke="#e8a0b0" stroke-width="3.5" fill="none" stroke-linecap="round"/>
              <path d="M 257 18 C 257 7 268 2 274 9 C 280 16 274 27 263 30"
                    stroke="#ddb8c0" stroke-width="3" fill="none" stroke-linecap="round"/>
              <text x="262" y="175" font-size="15" fill="#e8a0b0" opacity="0.85">♥</text>
              <text x="152" y="85"  font-size="11" fill="#c4637a" opacity="0.65">♥</text>
              <text x="140" y="210" font-size="9"  fill="#e8a0b0" opacity="0.7">♥</text>
            </svg>
          </div>
        </div>

        <!-- HERO COPY -->
        <div class="col-lg-7 hero-copy">

          <p class="hero-eyebrow">♥ &nbsp; Crochet With Heart &nbsp; ♥</p>

          <h1 class="hero-title">
            <%= lang === 'en' ? 'Croshim' : 'كروشيم' %><br>
            <span class="hero-title-accent"><%= lang === 'en' ? 'Studio' : 'ستوديو' %></span>
            <!-- Keyword line lives inside the H1 on purpose: it is the page's
                 main heading signal for كروشيه / باترون / crochet searches -->
            <span class="hero-title-keywords"><%= t.seo_home_h1_line %></span>
          </h1>

          <p class="hero-subtitle"><%= t.hero_subtitle %></p>

          <div id="products-section" class="hero-actions">
            <% if (!isAuthenticated) { %>
            <a href="#" class="btn hero-btn-outline" data-toggle="modal" data-target="#loginModal">
              <i class="fas fa-user"></i>
              <%= t.hero_signup %>
            </a>
            <% } else { %>
            <a href="/dashboard" class="btn hero-btn-outline">
              <i class="fas fa-th-large"></i>
              <%= t.hero_dashboard %>
            </a>
            <% } %>
          </div>

        </div>

      </div>
    </div>

  </section>

  <!-- WORKBOOK SHOWCASE -->
  <section class="workbook-showcase" data-aos="fade-up">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-5 workbook-copy">
          <p class="workbook-eyebrow">♥ <%= lang === 'en' ? 'FROM IDEA TO BEAUTIFUL PATTERN' : 'من الفكرة إلى باترون جميل' %> ♥</p>
          <h2><%= lang === 'en' ? 'Write your pattern your way' : 'اكتبي باترونك بطريقتك الجميلة' %></h2>
          <p class="workbook-intro"><%= lang === 'en' ? 'Everything you need to write, arrange, and share crochet patterns in one friendly place.' : 'كل ما تحتاجينه لكتابة وتنسيق باترونات الكروشيه في مكان واحد وبأسلوب يعكس شغفك.' %></p>
          <div class="workbook-benefits">
            <p><i class="fas fa-pen"></i><span><b><%= lang === 'en' ? 'Simple, organised editor' : 'محرر سهل ومنظّم' %></b><%= lang === 'en' ? 'Add materials, abbreviations, parts, and instructions.' : 'أضيفي الأدوات والاختصارات والأجزاء والخطوات بسهولة.' %></span></p>
            <p><i class="fas fa-file-pdf"></i><span><b><%= lang === 'en' ? 'A polished PDF pattern' : 'باترون PDF احترافي' %></b><%= lang === 'en' ? 'Preview, save, print, or share your finished work.' : 'عايني النتيجة ثم احفظيها أو اطبعيها أو شاركيها.' %></span></p>
            <p><i class="fas fa-folder-open"></i><span><b><%= lang === 'en' ? 'Your ideas in one place' : 'كل أفكارك في مكان واحد' %></b><%= lang === 'en' ? 'Return to and update your patterns anytime.' : 'ارجعي إلى باتروناتك وعدّليها في أي وقت.' %></span></p>
          </div>
          <% if (isAuthenticated) { %>
            <a class="btn workbook-cta" href="/pattern-builder"><i class="fas fa-magic"></i> <%= lang === 'en' ? 'Start writing your pattern' : 'ابدئي كتابة باترونك الآن' %></a>
          <% } else { %>
            <a class="btn workbook-cta" href="#" data-toggle="modal" data-target="#loginModal"><i class="fas fa-magic"></i> <%= lang === 'en' ? 'Start writing your pattern' : 'ابدئي كتابة باترونك الآن' %></a>
          <% } %>
        </div>

        <div class="col-lg-7 workbook-preview-col">
          <div class="workbook-window" dir="rtl">
            <div class="workbook-document">
              <div class="workbook-cover">
                <div class="workbook-brand">croshim<small>CROCHET WITH HEART</small></div>
                <div class="workbook-photo">🧶</div>
                <h3><%= lang === 'en' ? 'Bellflower Charm' : 'ميدالية زهرة الأجراس' %></h3>
                <p><%= lang === 'en' ? 'A cheerful crochet pattern' : 'باترون كروشيه لطيف' %></p>
                <div class="workbook-dots">● ● <b>●</b> ● ●</div>
                <footer><span>1 / 3</span><span>♥ ♥ ♥</span><em>croshim</em></footer>
              </div>
            </div>
            <aside class="workbook-editor">
              <h3><i class="fas fa-magic"></i> <%= lang === 'en' ? 'Pattern details' : 'معلومات الباترون' %></h3>
              <label><%= lang === 'en' ? 'Pattern name' : 'اسم الباترون' %></label><div class="editor-field"><%= lang === 'en' ? 'Bellflower charm' : 'ميدالية زهرة الأجراس' %></div>
              <label><%= lang === 'en' ? 'Skill level' : 'مستوى الصعوبة' %></label><div class="editor-field"><%= lang === 'en' ? 'Beginner' : 'مبتدئة' %>⌄</div>
              <label><%= lang === 'en' ? 'Materials' : 'الأدوات والخامات' %></label><div class="editor-tags"><span><%= lang === 'en' ? 'Cotton yarn' : 'خيط قطني' %></span><span><%= lang === 'en' ? 'Hook 2.5 mm' : 'إبرة 2.5 مم' %></span></div>
              <hr><h3><i class="fas fa-cut"></i> <%= lang === 'en' ? 'Pattern parts' : 'أجزاء الباترون' %></h3>
              <div class="editor-step">R1 <span><%= lang === 'en' ? 'Magic ring, 6 sc' : 'حلقة سحرية، 6 غرز' %></span></div>
              <div class="editor-step">R2 <span><%= lang === 'en' ? 'Increase x 6' : 'زيادة × 6' %></span></div>
              <div class="editor-step">R3 <span><%= lang === 'en' ? 'Repeat the stitches' : 'تكرار الغرز' %></span></div>
              <div class="editor-pdf"><i class="fas fa-file-pdf"></i> <%= lang === 'en' ? 'Preview PDF' : 'معاينة الباترون PDF' %></div>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES SECTION -->
  <section class="features-section" data-aos="fade-up">
    <div class="container">
      <h2 class="section-title"><%= t.features_title %></h2>
      <div class="row features-row">

        <div class="col-md-6 mb-6" data-aos="fade-up" data-aos-delay="0">
          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-file-pdf"></i></div>
            <h3 class="feature-title"><%= t.feature1_title %></h3>
            <p class="feature-desc"><%= t.feature1_desc %></p>
          </div>
        </div>

        <!-- <div class="col-md-6 mb-6" data-aos="fade-up" data-aos-delay="100">
          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-store"></i></div>
            <h3 class="feature-title"><%= t.feature2_title %></h3>
            <p class="feature-desc"><%= t.feature2_desc %></p>
          </div>
        </div> -->

        <div class="col-md-6 mb-6" data-aos="fade-up" data-aos-delay="200">
          <div class="feature-card">
            <div class="feature-icon"><i class="fas fa-book-open"></i></div>
            <h3 class="feature-title"><%= t.feature3_title %></h3>
            <p class="feature-desc"><%= t.feature3_desc %></p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section id="about" class="about-section" data-aos="fade-up">
    <div class="container">
      <div class="about-card">
        <div class="about-icon">🧶</div>
        <h2 class="section-title"><%= t.about_title %></h2>
        <p class="section-text"><%= t.about_text %></p>
      </div>
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <section id="contact" class="contact-section" data-aos="fade-up">
    <div class="container">
      <h2 class="section-title"><%= t.contact_title %></h2>
      <p class="contact-subtitle"><%= t.contact_subtitle %></p>
      <div class="contact-cards">

        <a class="contact-card" href="mailto:admin@croshim-studio.com">
          <div class="contact-card-icon email">
            <i class="fas fa-envelope"></i>
          </div>
          <span class="contact-card-label"><%= t.footer_email_label %></span>
          <span class="contact-card-value">admin@croshim-studio.com</span>
          <span class="contact-card-btn"><%= t.contact_email_btn %></span>
        </a>

        <a class="contact-card" href="https://wa.me/966507689445" target="_blank" rel="noopener noreferrer">
          <div class="contact-card-icon whatsapp">
            <i class="fab fa-whatsapp"></i>
          </div>
          <span class="contact-card-label">WhatsApp</span>
          <span class="contact-card-value" dir="ltr">+966 50 768 9445</span>
          <span class="contact-card-btn whatsapp-btn"><%= t.contact_whatsapp_btn %></span>
        </a>

      </div>
    </div>
  </section>

  <!-- ADD PRODUCT MODAL -->
  <%- include("../partials/add_product") %>

  <%- include("../partials/footer") %>

  <%- include("../partials/login-modal") %>


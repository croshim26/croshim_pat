  <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
  <script>AOS.init({ once: true, duration: 600 });</script>

  <style>
    .hero-art-col .yarn-art{display:none}.hero-workbook-preview{display:grid;grid-template-columns:.72fr 1.28fr;width:100%;max-width:650px;overflow:hidden;direction:ltr;border:7px solid rgba(255,255,255,.78);border-radius:26px;background:#fff6f8;box-shadow:0 24px 48px rgba(128,39,68,.2);transform:rotate(-1.5deg);transition:transform .25s}.hero-workbook-preview:hover{transform:rotate(0) translateY(-4px)}.hero-workbook-sidebar{padding:.8rem;background:#fff;color:#9d4e68;font-size:.58rem;direction:rtl}.hero-workbook-sidebar h3{margin:0 0 .6rem;color:#bd5677;font-size:.74rem;font-weight:900}.hero-workbook-sidebar label{display:block;margin:.48rem 0 .2rem;font-size:.56rem;font-weight:800}.hero-workbook-sidebar>div,.hero-workbook-sidebar li{display:flex;justify-content:space-between;padding:.3rem .4rem;border:1px solid #f3bdca;border-radius:8px;background:#fff8fa;font-weight:700}.hero-workbook-sidebar p{display:flex;flex-wrap:wrap;gap:.2rem;margin:.25rem 0}.hero-workbook-sidebar p span{padding:.18rem .3rem;border-radius:6px;background:#fae0e7;color:#ad5570;font-weight:800}.hero-workbook-sidebar hr{margin:.7rem 0;border:0;border-top:1px solid #f5d6de}.hero-workbook-sidebar ul{display:grid;gap:.28rem;margin:0;padding:0;list-style:none}.hero-workbook-sidebar li span{color:#824558}.hero-workbook-sidebar>b{display:block;margin-top:.7rem;padding:.48rem;border-radius:8px;color:#fff;background:#bd4f70;text-align:center}.hero-workbook-cover{display:flex;min-height:355px;align-items:center;flex-direction:column;justify-content:center;padding:1.2rem;border-radius:18px;color:#fff;text-align:center;background:radial-gradient(circle at 15% 12%,rgba(255,255,255,.18) 0 13%,transparent 13.5%),radial-gradient(circle at 85% 90%,rgba(255,255,255,.13) 0 12%,transparent 12.5%),linear-gradient(135deg,#f4a8bd,#d96d91)}.hero-workbook-cover>em{color:#8f3653;font:italic 1.7rem Georgia,serif}.hero-workbook-cover>em small{display:block;margin-top:.35rem;font:900 .45rem Arial,sans-serif;letter-spacing
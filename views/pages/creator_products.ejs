<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title><%= t.seo_site_name %> | <%= t.creators_products_by %></title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/base.css"><link rel="stylesheet" href="/css/layout.css"><link rel="stylesheet" href="/css/components.css"><link rel="stylesheet" href="/css/pages/products.css">
  <style>
    .creators-page{min-height:65vh;padding:48px 0 70px}.creator-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.creator-card{display:block;height:100%;padding:28px 24px;border:1px solid rgba(155,58,90,.12);border-radius:20px;background:#fff;color:#263246;text-decoration:none;box-shadow:0 10px 30px rgba(105,36,59,.08);transition:transform .2s,box-shadow .2s}.creator-card:hover{color:#263246;text-decoration:none;transform:translateY(-5px);box-shadow:0 16px 38px rgba(105,36,59,.17)}.creator-avatar{width:66px;height:66px;margin-bottom:18px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#9b3a5a,#e8a0b0);color:#fff;font-size:1.45rem}.creator-name{font-size:1.2rem;font-weight:900;margin:0 0 8px}.creator-count{color:#747d8c;font-weight:700;margin:0 0 20px}.creator-link{color:#a6385b;font-weight:900}.creator-link i{margin-inline-start:6px}.creator-hero{margin-bottom:30px}.creator-hero h1{font-weight:900;color:#263246;margin:0 0 8px}.creator-hero p{color:#70798a;font-size:1.02rem}.creator-products-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.creator-product{display:block;overflow:hidden;color:#263246;text-decoration:none;border-radius:18px;background:#fff;box-shadow:0 10px 28px rgba(105,36,59,.09)}.creator-product-cover{height:185px;width:100%;object-fit:cover;background:#fff5f7}.creator-product-body{padding:18px}.creator-product-emoji{display:grid;place-items:center;height:185px;font-size:4rem;background:#fff5f7}.creator-product:hover{color:#263246;text-decoration:none;transform:translateY(-3px)}.creator-product h2{font-size:1.05rem;font-weight:900}.creator-product p{font-size:.84rem;color:#6f7785;line-height:1.8;margin:0}.creator-tags{margin-top:10px;display:flex;gap:6px;flex-wrap:wrap}.creator-tags span{padding:4px 8px;border-radius:99px;background:#fff0f4;color:#a6385b;font-size:.68rem;font-weight:800}.back-link{display:inline-block;margin-bottom:18px;color:#8b3653;font-weight:800;text-decoration:none}.empty-state{background:#fff;border-radius:18px;padding:44px;text-align:center}@media(max-width:991px){.creator-grid,.creator-products-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:575px){.creators-page{padding:30px 0 50px}.creator-grid,.creator-products-grid{grid-template-columns:1fr}.creator-card{padding:22px}.creator-hero h1{font-size:1.8rem}}
  </style>
</head>
<body>
<%- include("../partials/navbar") %>
<main class="products-page creators-page"><div class="container"><a class="back-link" href="/creators"><i class="fas fa-arrow-right"></i> <%= t.creators_back %></a><header class="creator-hero"><h1><%= t.creators_products_by %> <%= [creator.firstName, creator.lastName].filter(Boolean).join(' ') %></h1><p><%= products.length %> <%= t.creators_product_count %></p></header>
<% if (!products.length) { %><div class="empty-state"><i class="fas fa-box-open fa-2x mb-3"></i><p class="mb-0"><%= t.creators_no_products %></p></div><% } else { %><div class="creator-products-grid"><% products.forEach(function (product) { const taxonomy = product.pattern && product.pattern.taxonomy; const title = taxonomy ? (lang === 'en' ? taxonomy.formal_name_en : taxonomy.formal_name_ar) : product.product_name; %><a class="creator-product" href="/all_products?creator=<%= product.user_id %>"><% if (product.pattern && product.pattern.cover_image) { %><img class="creator-product-cover" src="<%= product.pattern.cover_image %>" alt="<%= title %>" loading="lazy"><% } else { %><div class="creator-product-emoji"><%= (product.pattern && product.pattern.emoji) || '🧶' %></div><% } %><div class="creator-product-body"><h2><%= title || t.access_unknown %></h2><p><%= product.product_description || '' %></p><% if (taxonomy) { %><div class="creator-tags"><span><%= lang === 'en' ? taxonomy.pattern_type_en : taxonomy.pattern_type_ar %></span><span><%= lang === 'en' ? taxonomy.pattern_format_en : taxonomy.pattern_format_ar %></span></div><% } %></div></a><% }) %></div><div class="text-center mt-4"><a class="btn pdf-btn" href="/all_products"><%= t.creators_all_products %></a></div><% } %></div></main>
<%- include("../partials/footer") %>
<script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script><script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script><script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
</body></html>
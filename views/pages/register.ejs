<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">

<head>
  <meta charset="utf-8">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Croshim Studio | <%= t.register_title %></title>

  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/pages/auth.css">

  <style>
    .lang-switch-corner {
      position: fixed;
      top: 14px;
      left: 14px;
      z-index: 999;
    }
    [dir="rtl"] .lang-switch-corner { left: auto; right: 14px; }
    .lang-switch-corner form button {
      background: rgba(155,58,90,.1);
      border: 1px solid rgba(155,58,90,.3);
      border-radius: 10px;
      color: #9b3a5a;
      font-family: 'Cairo', sans-serif;
      font-weight: 800;
      font-size: .8rem;
      padding: .3rem .7rem;
      cursor: pointer;
    }
  </style>
</head>

<body>

  <%- include("../partials/demo_banner") %>

  <div class="lang-switch-corner">
    <form action="/set-lang" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="lang" value="<%= lang === 'ar' ? 'en' : 'ar' %>">
      <button type="submit"><%= t.nav_lang_switch %></button>
    </form>
  </div>

  <main class="auth-page">

    <div class="auth-card">

      <div class="auth-card-header">
        <a href="/" class="auth-brand">
          <span class="logo-badge">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M10 2 L10 13 C10 16.5 7 17.5 5.2 16 C3.5 14.5 4 12.5 6.2 12.2" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="10" cy="2" r="1.4" fill="white"/>
            </svg>
          </span>
          <span class="logo-name">Croshim Studio</span>
        </a>
        <h1><%= t.register_title %></h1>
        <p><%= t.register_subtitle %></p>
      </div>

      <% if (error_message) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <strong><%= t.alert_error_prefix %></strong> <%= error_message %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>

      <% if (success_message) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <strong><%= t.alert_success_prefix %></strong> <%= success_message %>
          <a href="/" class="alert-link"><%= t.alert_success_link %></a>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>

      <form action="/register" method="POST" class="register-form">

        <div class="form-row">

          <div class="form-group col-md-6">
            <label for="firstName"><%= t.label_first_name %></label>
            <div class="input-wrapper">
              <i class="fas fa-user"></i>
              <input type="text" id="firstName" name="firstName"
                class="form-control auth-input"
                placeholder="<%= t.placeholder_first_name %>" required>
            </div>
          </div>

          <div class="form-group col-md-6">
            <label for="lastName"><%= t.label_last_name %></label>
            <div class="input-wrapper">
              <i class="fas fa-user"></i>
              <input type="text" id="lastName" name="lastName"
                class="form-control auth-input"
                placeholder="<%= t.placeholder_last_name %>" required>
            </div>
          </div>

        </div>

        <div class="form-group">
          <label for="email"><%= t.label_email %></label>
          <div class="input-wrapper">
            <i class="fas fa-envelope"></i>
            <input type="email" id="email" name="email"
              class="form-control auth-input"
              placeholder="example@email.com" required>
          </div>
        </div>

        <div class="form-group">
          <label for="phone"><%= t.label_phone %></label>
          <div class="input-wrapper">
            <i class="fas fa-phone"></i>
            <input type="tel" id="phone" name="phone"
              class="form-control auth-input"
              placeholder="05xxxxxxxx" required>
          </div>
        </div>

        <div class="form-group">
          <label for="country"><%= t.label_country %></label>
          <div class="input-wrapper">
            <i class="fas fa-globe"></i>
            <select id="country" name="country" class="form-control auth-input">
              <option value="" disabled selected><%= t.placeholder_country %></option>
              <% if (lang === 'ar') { %>
                <option value="SA">المملكة العربية السعودية</option>
                <option value="AE">الإمارات العربية المتحدة</option>
                <option value="KW">الكويت</option>
                <option value="QA">قطر</option>
                <option value="BH">البحرين</option>
                <option value="OM">عُمان</option>
                <option value="EG">مصر</option>
                <option value="JO">الأردن</option>
                <option value="LB">لبنان</option>
                <option value="SY">سوريا</option>
                <option value="IQ">العراق</option>
                <option value="MA">المغرب</option>
                <option value="TN">تونس</option>
                <option value="DZ">الجزائر</option>
                <option value="LY">ليبيا</option>
                <option value="SD">السودان</option>
                <option value="YE">اليمن</option>
                <option value="PS">فلسطين</option>
                <option value="OTHER">أخرى</option>
              <% } else { %>
                <option value="SA">Saudi Arabia</option>
                <option value="AE">United Arab Emirates</option>
                <option value="KW">Kuwait</option>
                <option value="QA">Qatar</option>
                <option value="BH">Bahrain</option>
                <option value="OM">Oman</option>
                <option value="EG">Egypt</option>
                <option value="JO">Jordan</option>
                <option value="LB">Lebanon</option>
                <option value="SY">Syria</option>
                <option value="IQ">Iraq</option>
                <option value="MA">Morocco</option>
                <option value="TN">Tunisia</option>
                <option value="DZ">Algeria</option>
                <option value="LY">Libya</option>
                <option value="SD">Sudan</option>
                <option value="YE">Yemen</option>
                <option value="PS">Palestine</option>
                <option value="US">United States</option>
                <option value="GB">United Kingdom</option>
                <option value="DE">Germany</option>
                <option value="FR">France</option>
                <option value="CA">Canada</option>
                <option value="AU">Australia</option>
                <option value="OTHER">Other</option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-row">

          <div class="form-group col-md-6">
            <label for="gender"><%= t.label_gender %></label>
            <div class="input-wrapper">
              <i class="fas fa-venus-mars"></i>
              <select id="gender" name="gender" class="form-control auth-input">
                <option value="" disabled selected><%= t.placeholder_gender %></option>
                <option value="female"><%= t.gender_female %></option>
                <option value="male"><%= t.gender_male %></option>
              </select>
            </div>
          </div>

          <div class="form-group col-md-6">
            <label for="age"><%= t.label_age %></label>
            <div class="input-wrapper">
              <i class="fas fa-birthday-cake"></i>
              <input type="number" id="age" name="age"
                class="form-control auth-input"
                placeholder="<%= t.placeholder_age %>"
                min="10" max="100">
            </div>
          </div>

        </div>

        <div class="form-group">
          <label for="crochet_experience"><%= t.label_crochet_exp %></label>
          <div class="input-wrapper">
            <i class="fas fa-layer-group"></i>
            <select id="crochet_experience" name="crochet_experience" class="form-control auth-input">
              <option value="" disabled selected><%= t.placeholder_exp %></option>
              <option value="beginner"><%= t.exp_beginner %></option>
              <option value="intermediate"><%= t.exp_intermediate %></option>
              <option value="advanced"><%= t.exp_advanced %></option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="password"><%= t.label_password %></label>
          <div class="input-wrapper">
            <i class="fas fa-lock"></i>
            <input type="password" id="password" name="password"
              class="form-control auth-input"
              placeholder="********" minlength="8" required>
          </div>
        </div>

        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <button type="submit" class="btn auth-submit-btn btn-block">
          <%= t.btn_register %>
        </button>

        <div class="auth-switch">
          <%= t.have_account %>
          <a href="/"><%= t.go_login %></a>
        </div>

      </form>

    </div>

  </main>

  <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>

</body>
</html>

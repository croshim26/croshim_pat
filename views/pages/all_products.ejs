<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">

<head>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NCLMN2BEVN"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-NCLMN2BEVN');
  </script>
  <meta charset="utf-8">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Croshim Studio | جميع المنتجات</title>

  <!-- External CSS -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css">

  <!-- App CSS -->
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/pages/products.css">
</head>

<style>

.access-signup-note {
  max-width: 260px;
  margin: 12px auto 0;
  padding: 10px 12px;
  border: 1px solid rgba(155, 58, 90, 0.22);
  border-radius: 12px;
  background: rgba(255, 245, 247, 0.92);
  color: #596273;
  font-size: 0.78rem;
  font-weight: 700;
  line-height: 1.65;
  text-align: center;
}

.access-signup-note > i {
  color: #9b3a5a;
  margin-left: 4px;
}

.access-signup-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 7px;
  margin-top: 5px;
  color: #c24f72;
}

.access-signup-actions a,
.access-signup-actions button {
  border: 0;
  padding: 0;
  background: transparent;
  color: #b43d62;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
  text-decoration: none;
}

.access-signup-actions a:hover,
.access-signup-actions button:hover {
  color: #7e2947;
  text-decoration: underline;
}

</style>

<body>

  <!-- NAVBAR -->
  <%- include("../partials/navbar") %>

  <!-- PRODUCTS PAGE -->
  <main class="products-page">
    <div class="container">

      <!-- ALERTS -->
      <% if (success_message) { %>
        <div class="alert alert-success alert-dismissible fade show hero-alert mt-3" role="alert">
          <strong>تم بنجاح!</strong> <%= success_message %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>
      <% if (error_message) { %>
        <div class="alert alert-danger alert-dismissible fade show hero-alert mt-3" role="alert">
          <strong>خطأ!</strong> <%= error_message %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>

      <!-- PAGE HEADER -->
      <header class="page-header" data-aos="fade-up">
        <h1 class="products-title">جميع المنتجات</h1>
        <p class="products-subtitle">
          تصفح منتجات الكروشيه وملفات الباترن المتاحة
        </p>
      </header>

      <!-- SEARCH BAR: submitted to the server so it searches every page. -->
      <form class="search-wrap" data-aos="fade-up" action="/all_products" method="GET">
          <div class="search-input-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input
              type="search"
              name="q"
              class="form-control search-input"
              placeholder="ابحث عن منتج باسمه أو وصفه..."
              autocomplete="off"
              value="<%= searchQuery || '' %>"
            >
          </div>
          <button type="submit" class="search-submit">بحث</button>
          <span class="search-count">
            <%= pagination.totalProducts %> <%= searchQuery ? 'نتيجة' : 'منتج' %>
          </span>
      </form>

      <!-- PRODUCTS LIST -->
      <div class="row" id="productsGrid">

        <% if (products && products.length > 0) { %>

          <% products.forEach(function(product, index) { %>

            <div class="col-12 col-sm-6 col-md-4 mb-4 product-item"
              data-aos="fade-up"
              data-aos-delay="<%= index * 60 %>"
              data-name="<%= product.product_name.toLowerCase() %>"
              data-desc="<%= product.product_description.toLowerCase() %>"
            >
              <article class="card product-card">

                           <% if (product.pattern && product.pattern.cover_image) { %>
                    <img
                      src="<%= product.pattern.cover_image %>"
                      alt="<%= product.pattern.name || product.product_name %>"
                      class="product-cover"
                      loading="lazy"
                    >
                <% } %>


                <div class="product-header">
                  <span class="label-title">اسم المنتج</span>
                  <h2 class="product-name">
                    <%= product.product_name %>
                  </h2>
 

                </div>

                <div class="product-body">

                  <div class="product-meta">
                    <span class="label-title">اسم العميل</span>
                    <div class="product-owner">
                      <i class="fas fa-user"></i>
                      <span>
                        <%= product.user
                          ? product.user.firstName + " " + product.user.lastName
                          : "غير معروف"
                        %>
                      </span>
                    </div>
                  </div>


                  <div class="product-meta">
                    <span class="label-title">وصف المنتج</span>
                    <p class="product-description">
                      <%= product.product_description %>
                    </p>
                  </div>
                    
           <div class="product-meta">
  <span class="label-title">ملف المنتج</span>

  <% if (!product.pdf_path) { %>
    <div class="no-file">
      <i class="far fa-folder-open"></i>
      لا يوجد ملف للمنتج
    </div>

  <% } else if (product.is_pattern_published) { %>
    <!-- Owner published this PDF for everybody -->
    <a
      href="<%= product.pdf_path %>"
      target="_blank"
      class="btn pdf-btn"
      rel="noopener noreferrer"
    >
      <i class="fas fa-file-pdf"></i>
      عرض ملف المنتج
    </a>

  <% } else if (isAuthenticated) { %>
    <!-- File is private: logged-in user can request permission -->
    <form action="/products/<%= product.id %>/request-access" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <button type="submit" class="btn pdf-btn">
        <i class="fas fa-lock"></i>
        طلب الوصول للملف
      </button>
    </form>

  <% } else { %>
    <!-- File is private: visitor must sign up first -->
    <button
      type="button"
      class="btn pdf-btn"
      data-toggle="modal"
      data-target="#loginModal"
    >
      <i class="fas fa-lock"></i>
      طلب الوصول للملف
    </button>

    <div class="access-signup-note">
      <i class="fas fa-lock"></i>
      <span>لطلب الوصول للملف، يرجى إنشاء حساب أو تسجيل الدخول.</span>

      <div class="access-signup-actions">
        <a href="/register">إنشاء حساب</a>
        <span>·</span>
        <button type="button" data-toggle="modal" data-target="#loginModal">
          تسجيل الدخول
        </button>
      </div>
    </div>
  <% } %>
</div>

                </div>
              </article>
            </div>

          <% }) %>

        <% } else { %>

          <div class="col-12" data-aos="fade-up">
            <div class="empty-state">
              <i class="fas fa-box-open empty-icon"></i>
              <h5>لا توجد منتجات حالياً</h5>
              <p>يمكنك إضافة منتج جديد من خلال نموذج الإضافة.</p>
            </div>
          </div>

        <% } %>

      </div>

      <% if (pagination.totalPages > 1) { %>
        <% const searchSuffix = searchQuery ? '&q=' + encodeURIComponent(searchQuery) : ''; %>
        <nav class="products-pager" aria-label="صفحات المنتجات">
          <% if (pagination.page > 1) { %>
            <a class="pager-btn" href="/all_products?page=<%= pagination.page - 1 %><%= searchSuffix %>">
              <i class="fas fa-chevron-right"></i> السابق
            </a>
          <% } %>

          <% pagination.pageNumbers.forEach(function (pageNumber) { %>
            <% if (pageNumber === pagination.page) { %>
              <span class="pager-btn is-current" aria-current="page"><%= pageNumber %></span>
            <% } else { %>
              <a class="pager-btn" href="/all_products?page=<%= pageNumber %><%= searchSuffix %>"><%= pageNumber %></a>
            <% } %>
          <% }) %>

          <% if (pagination.page < pagination.totalPages) { %>
            <a class="pager-btn" href="/all_products?page=<%= pagination.page + 1 %><%= searchSuffix %>">
              التالي <i class="fas fa-chevron-left"></i>
            </a>
          <% } %>
        </nav>
      <% } %>
    </div>
  </main>

  <!-- ADD PRODUCT MODAL -->
  <%- include("../partials/add_product") %>

  <!-- FOOTER -->
  <%- include("../partials/footer") %>

  <%- include("../partials/login-modal") %>

  <!-- JS -->
  <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
  <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
  <script>AOS.init({ once: true, duration: 500 });</script>



</body>
</html>

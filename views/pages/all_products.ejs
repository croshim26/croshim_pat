<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">

<head>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NCLMN2BEVN"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-NCLMN2BEVN');
  </script>
  <meta charset="utf-8">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t.seo_site_name %> | <%= t.products_all_title %></title>

  <!-- External CSS -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css">

  <!-- App CSS -->
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/pages/products.css">
</head>

<style>

.access-signup-note {
  max-width: 260px;
  margin: 12px auto 0;
  padding: 10px 12px;
  border: 1px solid rgba(155, 58, 90, 0.22);
  border-radius: 12px;
  background: rgba(255, 245, 247, 0.92);
  color: #596273;
  font-size: 0.78rem;
  font-weight: 700;
  line-height: 1.65;
  text-align: center;
}

.access-signup-note > i {
  color: #9b3a5a;
  margin-left: 4px;
}

.access-signup-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 7px;
  margin-top: 5px;
  color: #c24f72;
}

.access-signup-actions a,
.access-signup-actions button {
  border: 0;
  padding: 0;
  background: transparent;
  color: #b43d62;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
  text-decoration: none;
}

.access-signup-actions a:hover,
.access-signup-actions button:hover {
  color: #7e2947;
  text-decoration: underline;
}

.product-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.my-product-flag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 9px;
  border-radius: 20px;
  background: #fff0f4;
  border: 1px solid #efb8c7;
  color: #a6385b;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
}

.product-owner-file-note,
.access-approved-note,
.access-pending-note,
.access-rejected-note {
  margin: 8px 0;
  padding: 8px 10px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 800;
  text-align: center;
}

.product-owner-file-note {
  background: #fff0f4;
  color: #a6385b;
  border: 1px solid #efbdca;
}

.access-approved-note {
  background: #e8f7ed;
  color: #24713d;
  border: 1px solid #bde5c9;
}

.access-pending-note {
  background: #fff8df;
  color: #9b7514;
  border: 1px solid #f0dc9a;
}

.access-rejected-note {
  background: #fff0f0;
  color: #b33333;
  border: 1px solid #efbcbc;
}

.request-again-btn {
  width: 100%;
  margin-top: 8px;
  padding: 9px;
  border: 1px solid #b74769;
  border-radius: 8px;
  background: #fff;
  color: #a6385b;
  font-weight: 800;
  cursor: pointer;
}

.request-again-btn:hover {
  background: #fff0f4;
}



</style>

<body>

  <!-- NAVBAR -->
  <%- include("../partials/navbar") %>

  <!-- PRODUCTS PAGE -->
  <main class="products-page">
    <div class="container">

      <!-- ALERTS -->
      <% if (success_message) { %>
        <div class="alert alert-success alert-dismissible fade show hero-alert mt-3" role="alert">
          <strong><%= t.alert_success_prefix %></strong> <%= success_message %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>
      <% if (error_message) { %>
        <div class="alert alert-danger alert-dismissible fade show hero-alert mt-3" role="alert">
          <strong><%= t.alert_error_prefix %></strong> <%= error_message %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>

      <!-- PAGE HEADER -->
      <header class="page-header" data-aos="fade-up">
        <h1 class="products-title"><%= t.products_all_title %></h1>
        <p class="products-subtitle">
          <%= t.products_browse_subtitle %>
        </p>
      </header>

      <!-- SEARCH BAR: submitted to the server so it searches every page. -->
      <form class="search-wrap" data-aos="fade-up" action="/all_products" method="GET">
          <div class="search-input-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input
              type="search"
              name="q"
              class="form-control search-input"
              placeholder="<%= t.products_search_placeholder %>"
              autocomplete="off"
              value="<%= searchQuery || '' %>"
            >
          </div>
          <button type="submit" class="search-submit"><%= t.btn_search %></button>
          <span class="search-count">
            <%= pagination.totalProducts %> <%= t.stat_label %>
          </span>
      </form>

      <!-- PRODUCTS LIST -->
      <div class="row" id="productsGrid">

        <% if (products && products.length > 0) { %>

          <% products.forEach(function(product, index) { %>

            <div class="col-12 col-sm-6 col-md-4 mb-4 product-item"
              data-aos="fade-up"
              data-aos-delay="<%= index * 60 %>"
              data-name="<%= product.product_name.toLowerCase() %>"
              data-desc="<%= product.product_description.toLowerCase() %>"
            >
              <article class="card product-card">

                           <% if (product.pattern && product.pattern.cover_image) { %>
                    <img
                      src="<%= product.pattern.cover_image %>"
                      alt="<%= product.pattern.name || product.product_name %>"
                      class="product-cover"
                      loading="lazy"
                    >
                <% } %>


                <div class="product-header">
                  <span class="label-title"><%= t.label_product_name %></span>
                  <h2 class="product-name">
                    <%= product.product_name %>
                  </h2>
                      <% if (
      viewerUserId &&
      Number(product.user_id) === Number(viewerUserId)
    ) { %>
      <span class="my-product-flag">
        <i class="fas fa-flag"></i>
        <%= t.products_my_flag %>
      </span>
    <% } %>
 

                </div>

                <div class="product-body">

                  <div class="product-meta">
                    <span class="label-title"><%= t.products_owner %></span>
                    <div class="product-owner">
                      <i class="fas fa-user"></i>
                      <span>
                        <%= product.user
                          ? product.user.firstName + " " + product.user.lastName
                          : t.access_unknown
                        %>
                      </span>
                    </div>
                  </div>


                  <div class="product-meta">
                    <span class="label-title"><%= t.label_product_desc %></span>
                    <p class="product-description">
                      <%= product.product_description %>
                    </p>
                  </div>
                    
<div class="product-meta">
  <span class="label-title"><%= t.label_product_file %></span>

  <% if (!product.pdf_path) { %>

    <div class="no-file">
      <i class="far fa-folder-open"></i>
      <%= t.no_file %>
    </div>

  <% } else if (product.isOwner) { %>

    <div class="product-owner-file-note">
      <i class="fas fa-flag"></i>
      <%= t.products_my_note %>
    </div>

    <a
      href="<%= product.pdf_path %>"
      target="_blank"
      class="btn pdf-btn"
      rel="noopener noreferrer"
    >
      <i class="fas fa-book-open"></i>
      <%= t.products_open %>
    </a>

  <% } else if (product.is_pattern_published) { %>

    <a
      href="<%= product.pdf_path %>"
      target="_blank"
      class="btn pdf-btn"
      rel="noopener noreferrer"
    >
      <i class="fas fa-file-pdf"></i>
      <%= t.access_view_file %>
    </a>

  <% } else if (isAuthenticated && product.accessStatus === "approved") { %>

    <div class="access-approved-note">
      <i class="fas fa-check-circle"></i>
      <%= t.products_access_approved %>
    </div>

    <a
      href="<%= product.pdf_path %>"
      target="_blank"
      class="btn pdf-btn"
      rel="noopener noreferrer"
    >
      <i class="fas fa-book-open"></i>
      <%= t.products_open %>
    </a>

  <% } else if (isAuthenticated && product.accessStatus === "pending") { %>

    <div class="access-pending-note">
      <i class="fas fa-clock"></i>
      <%= t.products_request_pending %>
    </div>

  <% } else if (isAuthenticated && product.accessStatus === "rejected") { %>

  <div class="access-rejected-note">
    <i class="fas fa-times-circle"></i>
    <%= t.products_request_rejected %>
  </div>

  <form action="/products/<%= product.id %>/request-access" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <button type="submit" class="btn request-again-btn">
      <i class="fas fa-redo"></i>
      <%= t.products_request_again %>
    </button>
  </form>

  <% } else if (isAuthenticated) { %>

    <form action="/products/<%= product.id %>/request-access" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <button type="submit" class="btn pdf-btn">
        <i class="fas fa-lock"></i>
        <%= t.products_request_file %>
      </button>
    </form>

  <% } else { %>

    <button
      type="button"
      class="btn pdf-btn"
      data-toggle="modal"
      data-target="#loginModal"
    >
      <i class="fas fa-lock"></i>
      <%= t.products_request_file %>
    </button>

    <div class="access-signup-note">
      <i class="fas fa-lock"></i>
      <span><%= t.products_login_to_request %></span>

      <div class="access-signup-actions">
        <a href="/register"><%= t.link_register %></a>
        <span>·</span>
        <button type="button" data-toggle="modal" data-target="#loginModal">
          <%= t.nav_login %>
        </button>
      </div>
    </div>

  <% } %>
</div>

                </div>
              </article>
            </div>

          <% }) %>

        <% } else { %>

          <div class="col-12" data-aos="fade-up">
            <div class="empty-state">
              <i class="fas fa-box-open empty-icon"></i>
              <h5><%= t.products_no_items %></h5>
              <p><%= t.products_no_items_desc %></p>
            </div>
          </div>

        <% } %>

      </div>

      <% if (pagination.totalPages > 1) { %>
        <% const searchSuffix = searchQuery ? '&q=' + encodeURIComponent(searchQuery) : ''; %>
        <nav class="products-pager" aria-label="<%= t.products_all_title %>">
          <% if (pagination.page > 1) { %>
            <a class="pager-btn" href="/all_products?page=<%= pagination.page - 1 %><%= searchSuffix %>">
              <i class="fas fa-chevron-right"></i> <%= t.products_previous %>
            </a>
          <% } %>

          <% pagination.pageNumbers.forEach(function (pageNumber) { %>
            <% if (pageNumber === pagination.page) { %>
              <span class="pager-btn is-current" aria-current="page"><%= pageNumber %></span>
            <% } else { %>
              <a class="pager-btn" href="/all_products?page=<%= pageNumber %><%= searchSuffix %>"><%= pageNumber %></a>
            <% } %>
          <% }) %>

          <% if (pagination.page < pagination.totalPages) { %>
            <a class="pager-btn" href="/all_products?page=<%= pagination.page + 1 %><%= searchSuffix %>">
              <%= t.products_next %> <i class="fas fa-chevron-left"></i>
            </a>
          <% } %>
        </nav>
      <% } %>
    </div>
  </main>

  <!-- ADD PRODUCT MODAL -->
  <%- include("../partials/add_product") %>

  <!-- FOOTER -->
  <%- include("../partials/footer") %>

  <%- include("../partials/login-modal") %>

  <!-- JS -->
  <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
  <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
  <script>AOS.init({ once: true, duration: 500 });</script>



</body>
</html>
